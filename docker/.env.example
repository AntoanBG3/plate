# Copy to docker/.env on the server and fill in. docker/.env is git-ignored.
POSTGRES_DB=gym
POSTGRES_USER=gym
# Generate with: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# Food text parsing. Without a key the app uses a simple built-in parser.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Open Food Facts asks apps to identify themselves with a contact address.
OFF_CONTACT_EMAIL=
