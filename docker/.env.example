# Copy to docker/.env on the server and fill in. docker/.env is git-ignored.
POSTGRES_DB=gym
POSTGRES_USER=gym
# Generate with: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# Food text parsing through OpenRouter. Without a key the app uses a simple built-in parser. A key saved in
# the app's Settings page replaces this one, so this can stay empty. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model used until one is picked in Settings; empty means google/gemini-3.5-flash-lite.
OPENROUTER_MODEL=

# Open Food Facts asks apps to identify themselves with a contact address.
OFF_CONTACT_EMAIL=
