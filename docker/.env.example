# Copy to docker/.env on the server and fill in. docker/.env is git-ignored.
POSTGRES_DB=gym
POSTGRES_USER=gym
# Generate with: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# Food text parsing through OpenRouter. Without a key the app uses a simple built-in parser. A key saved in
# the app's Settings page replaces this one, so this can stay empty. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model used until one is picked in Settings; empty means openai/gpt-6-luna.
OPENROUTER_MODEL=

# Open Food Facts asks apps to identify themselves with a contact address.
OFF_CONTACT_EMAIL=

# Content-Security-Policy: false sends it report-only (violations are logged as "CSP violation"); set to true
# once a few days of normal use log none.
CSP_ENFORCE=false

# Optional: a Telegram message for each new feedback report and each new kind of error (SPEC 11). Only the
# report's number, the reporter's name, kind, area and first 80 characters are sent. Leave empty to turn off.
# The backup script's bot and chat can be reused.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare Access in front of /admin (SPEC 12, README "Admin"): the Zero Trust team domain and the Access
# application's AUD tag. Not secrets. Until both are set, the admin area is off in production.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
