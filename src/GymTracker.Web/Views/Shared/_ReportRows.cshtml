@model List<GymTracker.Web.Features.Feedback.FeedbackRow>
@* Report rows for the admin area's dashboard and list. *@
<div class="list">
    @foreach (var r in Model)
    {
        var what = r.Message ?? (r.Rating is { } rating ? $"Parse rated {rating.ToString().ToLowerInvariant()}" + (r.Reasons != ParseReason.None ? ": " + r.Reasons : "") : "");
        <a class="feedback-item row-link" href="/admin/feedback/@r.Id">
            <div class="feedback-head">
                <span class="footnote">#@r.Id · @r.CreatedAt.ToUniversalTime().ToString("d MMM HH:mm") · @r.Reporter · @r.Area</span>
                <span class="chip@(r.Status == FeedbackStatus.New ? " ai" : r.Status == FeedbackStatus.Fixed ? " good" : "")">@r.Status</span>
            </div>
            <p class="feedback-message">@(what.Length > 160 ? what[..160] + "…" : what)</p>
            @if (r.HasScreenshot || r.HasReply || r.ParseRunId is not null)
            {
                <span class="footnote">@string.Join(" · ", new[] { r.HasScreenshot ? "screenshot" : null, r.HasReply ? "replied" : null, r.ParseRunId is { } run ? $"parse {run}" : null }.OfType<string>())</span>
            }
        </a>
    }
    @if (Model.Count == 0)
    {
        <div class="row"><span class="row-main footnote">Nothing here.</span></div>
    }
</div>
