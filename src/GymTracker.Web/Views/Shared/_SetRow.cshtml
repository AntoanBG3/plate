@model SetRowViewModel
@{
    var set = Model.Logged;
    const string Check = "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path class=\"check\" pathLength=\"1\" d=\"M5.5 12.5l4.25 4.25L18.5 7.5\"/></svg>";
}
@if (set is not null)
{
    <form class="set-row done@(Model.IsWarmup ? " warmup" : "")" data-client-id="@set.ClientId" hx-post="/train/sets/@set.Id/update" hx-target="this" hx-swap="outerHTML">
        <button type="button" class="set-delete" hx-post="/train/sets/@set.Id/delete" hx-target="closest form" hx-swap="outerHTML swap:180ms">@L["Delete"]</button>
        <div class="set-content">
            <span class="set-n" aria-hidden="true">@(Model.IsWarmup ? L["W"] : "")</span>
            <label class="set-field"><input type="number" name="weightKg" value="@set.WeightKg.Kg()" inputmode="decimal" step="any" min="0" aria-label="@L["Weight in kg"]" required /><small>@L["kg"]</small></label>
            <label class="set-field"><input type="number" name="reps" value="@set.Reps" inputmode="numeric" step="1" min="0" aria-label="@L["Reps"]" required /><small>@L["reps"]</small></label>
            <button type="submit" class="done-btn" aria-label="@L["Save changes"]"><span class="disc">@Html.Raw(Check)</span></button>
        </div>
    </form>
}
else
{
    @* Submitted by session.js, which saves the set on the phone before sending it. Suggested values are
       placeholders, copied into the field when the set is logged, so they look different from entered ones. *@
    <form class="set-row@(Model.IsWarmup ? " warmup" : "")" data-log-set data-client-id="@Model.ClientId">
        <input type="hidden" name="clientId" value="@Model.ClientId" />
        <input type="hidden" name="sessionExerciseId" value="@Model.SessionExerciseId" />
        <input type="hidden" name="isWarmup" value="@(Model.IsWarmup ? "true" : "false")" />
        <div class="set-content">
            <span class="set-n" aria-hidden="true">@(Model.IsWarmup ? L["W"] : "")</span>
            <label class="set-field"><input type="number" name="weightKg" placeholder="@(Model.Target?.WeightKg.Kg() ?? "")" data-suggested="@(Model.Target?.WeightKg.Kg())" inputmode="decimal" step="any" min="0" aria-label="@(Model.Target is { } w ? L["Weight in kg, suggested {0}", w.WeightKg.Kg()] : L["Weight in kg"])" required /><small>@L["kg"]</small></label>
            <label class="set-field"><input type="number" name="reps" placeholder="@(Model.Target?.Reps)" data-suggested="@(Model.Target?.Reps)" inputmode="numeric" step="1" min="0" aria-label="@(Model.Target is { } r ? L["Reps, suggested {0}", r.Reps] : L["Reps"])" required /><small>@L["reps"]</small></label>
            <button type="submit" class="done-btn" aria-label="@L["Log set"]"><span class="disc">@Html.Raw(Check)</span></button>
            <span class="set-status" role="status">@Ui.Icon("pending", "icon-sm")@L["Waiting for signal"]</span>
        </div>
    </form>
}
