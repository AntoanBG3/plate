@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var path = Context.Request.Path.Value ?? "";
    var showTabs = ViewData["HideTabs"] is not true;
    string Tab(string prefix) => path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? "tab active" : "tab";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#07090a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="htmx-config" content='{"defaultSwapStyle":"outerHTML","historyCacheSize":0}' />
    <title>@(ViewData["Title"] is string t ? $"{t} · Gym" : "Gym")</title>
    <link rel="stylesheet" href="~/lib/fonts/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/lib/htmx/htmx.min.js" asp-append-version="true" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body hx-headers='{"RequestVerificationToken": "@token"}'>
    <main class="page">
        @if (TempData[FeatureExceptionFilter.ErrorKey] is string error)
        {
            <p class="error" role="alert">@error</p>
        }
        @if (TempData["Message"] is string message)
        {
            <p class="notice" role="status">@message</p>
        }
        @RenderBody()
    </main>
    <div id="toast" class="toast" role="alert" hidden></div>
    @if (showTabs)
    {
        <nav class="tabs" aria-label="Main">
            <a class="@Tab("/today")" href="/today"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>Today</a>
            <a class="@Tab("/train")" href="/train"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 7v10M18 7v10M3 10v4M21 10v4M6 12h12"/></svg>Train</a>
            <a class="@Tab("/food")" href="/food"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 3v8a3 3 0 0 0 6 0V3M10 3v18M17 3c-2 2-2 6 0 8v10"/></svg>Food</a>
            <a class="@Tab("/progress")" href="/progress"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19h16M6 16l4-5 3 3 5-7"/></svg>Progress</a>
            <a class="@Tab("/settings")" href="/settings"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M5 19l2-2M17 7l2-2"/></svg>Settings</a>
        </nav>
    }
</body>
</html>
