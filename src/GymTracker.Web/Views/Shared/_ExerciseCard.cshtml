@model ExerciseCardViewModel
@{
    var Ex = Model.Exercise;
    var warmups = Ex.Sets.Where(s => s.IsWarmup).OrderBy(s => s.SetNumber).ToList();
    var working = Ex.Sets.Where(s => !s.IsWarmup).OrderBy(s => s.SetNumber).ToList();
    var blanks = Math.Max(0, Ex.WorkingSets - working.Count);
    var name = L.Exercise(Ex.Exercise);
}
<section class="exercise" id="ex-@Ex.Id" data-rest="@Ex.RestSeconds" data-name="@name">
    <div class="ex-head">
        <div>
            <h2 class="ex-name">@name</h2>
            @if (Model.Note is { } note)
            {
                <p class="ex-note">@note</p>
            }
            <p class="ex-meta">@L["{0}–{1} reps · {2} · rest {3}", Ex.RepMin, Ex.RepMax, L.Count(Ex.WorkingSets, "1 set", "{0} sets"), Format.Rest(Ex.RestSeconds)]</p>
        </div>
        <div class="menu-wrap">
            <button type="button" class="icon-btn" data-menu-trigger aria-expanded="false" aria-label="@L["Actions for {0}", name]">@Ui.Icon("more")</button>
            <div class="menu" role="menu">
                <form method="post" asp-antiforgery="true" action="/train/session-exercises/@Ex.Id/move"><input type="hidden" name="direction" value="-1" /><button type="submit" role="menuitem">@L["Move up"]@Ui.Icon("up")</button></form>
                <form method="post" asp-antiforgery="true" action="/train/session-exercises/@Ex.Id/move"><input type="hidden" name="direction" value="1" /><button type="submit" role="menuitem">@L["Move down"]@Ui.Icon("down")</button></form>
                <button type="button" role="menuitem" hx-get="/train/exercises/@Ex.ExerciseId/settings?returnUrl=@Uri.EscapeDataString($"/train/sessions/{Ex.SessionId}")" hx-target="#exercise-sheet-body" hx-swap="innerHTML" data-sheet-open="exercise-sheet">@L["Notes & bar"]@Ui.Icon("pencil")</button>
                @if (Ex.Sets.Count == 0)
                {
                    <a href="/train/session-exercises/@Ex.Id/swap" role="menuitem">@L["Swap exercise"]@Ui.Icon("reorder")</a>
                }
                <form method="post" asp-antiforgery="true" action="/train/session-exercises/@Ex.Id/remove" data-confirm="@L["Remove this exercise and its sets from the workout?"]"><button type="submit" role="menuitem" class="danger">@L["Remove exercise"]@Ui.Icon("trash")</button></form>
            </div>
        </div>
    </div>
    <div class="ex-body">
        @if (Model.Suggestion is { } suggestion)
        {
            <p class="suggestion @suggestion.Kind.ToString().ToLowerInvariant()">@Ui.Icon(suggestion.Kind == GymTracker.Core.Training.ProgressionKind.Deload ? "deload" : "trend")<span>@L[suggestion.Reason]</span></p>
        }
        <div class="rows warmups" id="warmups-@Ex.Id">
            @foreach (var set in warmups)
            {
                <partial name="_SetRow" model="SetRowViewModel.For(set)" />
            }
        </div>
        <div class="rows working" id="rows-@Ex.Id">
            @foreach (var set in working)
            {
                <partial name="_SetRow" model="SetRowViewModel.For(set)" />
            }
            @for (var i = 0; i < blanks; i++)
            {
                <partial name="_SetRow" model="SetRowViewModel.Blank(Ex.Id, false, Model.TargetFor(working.Count + i))" />
            }
        </div>
        <div class="ex-actions">
            <button type="button" hx-get="/train/session-exercises/@Ex.Id/row?warmup=false" hx-target="#rows-@Ex.Id" hx-swap="beforeend">@Ui.Icon("plus")@L["Add set"]</button>
            <button type="button" hx-get="/train/session-exercises/@Ex.Id/row?warmup=true" hx-target="#warmups-@Ex.Id" hx-swap="beforeend">@Ui.Icon("plus")@L["Warm-up"]</button>
            @if (Model.BarKg is not null)
            {
                <button type="button" hx-get="/train/session-exercises/@Ex.Id/plates?suggested=@(Model.TargetFor(0)?.WeightKg.Kg())" hx-target="#plates-body" hx-swap="innerHTML" data-sheet-open="plates-sheet">@Ui.Icon("list")@L["Plates"]</button>
            }
        </div>
    </div>
</section>
