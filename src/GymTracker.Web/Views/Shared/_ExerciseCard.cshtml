@model ExerciseCardViewModel
@{
    var Ex = Model.Exercise;
    var warmups = Ex.Sets.Where(s => s.IsWarmup).OrderBy(s => s.SetNumber).ToList();
    var working = Ex.Sets.Where(s => !s.IsWarmup).OrderBy(s => s.SetNumber).ToList();
    var blanks = Math.Max(0, Ex.WorkingSets - working.Count);
}
<section class="card exercise" id="ex-@Ex.Id" data-rest="@Ex.RestSeconds">
    <header class="row-between">
        <div>
            <h2>@Ex.Exercise.Name</h2>
            <p class="muted">@Ex.RepMin–@Ex.RepMax reps · @Ex.WorkingSets sets · rest @Format.Rest(Ex.RestSeconds)</p>
        </div>
        <div class="icon-buttons">
            <form method="post" asp-antiforgery="true" action="/train/session-exercises/@Ex.Id/move"><input type="hidden" name="direction" value="-1" /><button type="submit" aria-label="Move up">↑</button></form>
            <form method="post" asp-antiforgery="true" action="/train/session-exercises/@Ex.Id/move"><input type="hidden" name="direction" value="1" /><button type="submit" aria-label="Move down">↓</button></form>
            <form method="post" asp-antiforgery="true" action="/train/session-exercises/@Ex.Id/remove" onsubmit="return confirm('Remove this exercise and its sets from the session?')"><button type="submit" aria-label="Remove exercise">✕</button></form>
        </div>
    </header>
    @if (Model.Suggestion is { } suggestion)
    {
        <p class="suggestion @suggestion.Kind.ToString().ToLowerInvariant()">@suggestion.Reason</p>
    }
    <div class="set-head"><span></span><span>kg</span><span>reps</span><span></span></div>
    <div class="rows warmups" id="warmups-@Ex.Id">
        @foreach (var set in warmups)
        {
            <partial name="_SetRow" model="SetRowViewModel.For(set)" />
        }
    </div>
    <div class="rows working" id="rows-@Ex.Id">
        @foreach (var set in working)
        {
            <partial name="_SetRow" model="SetRowViewModel.For(set)" />
        }
        @for (var i = 0; i < blanks; i++)
        {
            <partial name="_SetRow" model="SetRowViewModel.Blank(Ex.Id, false, Model.TargetFor(working.Count + i))" />
        }
    </div>
    <div class="card-actions">
        <button type="button" hx-get="/train/session-exercises/@Ex.Id/row?warmup=true" hx-target="#warmups-@Ex.Id" hx-swap="beforeend">+ Warmup</button>
        <button type="button" hx-get="/train/session-exercises/@Ex.Id/row?warmup=false" hx-target="#rows-@Ex.Id" hx-swap="beforeend">+ Set</button>
    </div>
</section>
