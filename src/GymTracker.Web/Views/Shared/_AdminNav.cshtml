@* The admin area's sections, under each page's title. *@
@{
    var path = Context.Request.Path.Value ?? "";
    (string Href, string Label)[] links =
    [
        ("/admin", "Overview"), ("/admin/feedback", "Reports"), ("/admin/parses", "Parses"), ("/admin/errors", "Errors"),
        ("/admin/changelog", "What's new"), ("/admin/ai", "AI"), ("/admin/ai/eval", "Eval"), ("/admin/users", "Users"), ("/admin/audit", "Audit"),
    ];
    string? Current(string href) => (href == "/admin" ? path == "/admin" : path.StartsWith(href, StringComparison.Ordinal) && !(href == "/admin/ai" && path.StartsWith("/admin/ai/eval", StringComparison.Ordinal))) ? "page" : null;
}
<nav class="admin-nav" aria-label="Admin">
    @foreach (var (href, label) in links)
    {
        <a href="@href" class="chip@(Current(href) is not null ? " ai" : "")" aria-current="@Current(href)">@label</a>
    }
</nav>
