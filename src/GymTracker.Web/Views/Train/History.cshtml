@model List<HistoryItem>
@inject UserTime Time
@{ ViewData["Title"] = "History"; }
<h1>History</h1>
@if (Model.Count == 0)
{
    <p class="muted">No sessions yet.</p>
}
<ul class="list">
    @foreach (var item in Model)
    {
        var started = await Time.LocalAsync(item.StartedAt);
        <li>
            <a href="/train/sessions/@item.Id">
                <strong>@item.Name</strong>
                <span class="muted">
                    @started.ToString("ddd d MMM, HH:mm", System.Globalization.CultureInfo.InvariantCulture)
                    · @item.WorkingSets sets
                    · @(item.EndedAt is { } end ? (end - item.StartedAt).Elapsed() : "in progress")
                </span>
            </a>
        </li>
    }
</ul>
<p><a href="/train">Back</a></p>
