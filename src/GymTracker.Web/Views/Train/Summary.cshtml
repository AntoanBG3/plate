@model SummaryViewModel
@{
    var session = Model.Summary.Session;
    ViewData["Title"] = "Summary";
}
<h1>@(session.Template?.Name ?? "Freestyle")</h1>
<section class="card stats">
    <div><span class="big">@Model.Summary.Duration.Elapsed()</span><span class="muted">Duration</span></div>
    <div><span class="big">@Model.Summary.WorkingSets</span><span class="muted">Working sets</span></div>
    <div><span class="big">@Model.Records.Count</span><span class="muted">New records</span></div>
</section>
@if (Model.Records.Count > 0)
{
    <section class="card highlight">
        <h2>New records</h2>
        <ul class="list">
            @foreach (var record in Model.Records)
            {
                <li class="row-between">
                    <strong>@record.ExerciseName</strong>
                    <span>@record.E1rmKg.Kg() kg e1RM <span class="muted">(was @record.PreviousBestKg?.Kg())</span></span>
                </li>
            }
        </ul>
    </section>
}
<ul class="list">
    @foreach (var exercise in session.Exercises)
    {
        var sets = exercise.Sets.Where(s => !s.IsWarmup).ToList();
        <li>
            <strong>@exercise.Exercise.Name</strong>
            <span class="muted">@(sets.Count == 0 ? "no sets" : string.Join(", ", sets.Select(s => $"{s.WeightKg.Kg()}×{s.Reps}")))</span>
        </li>
    }
</ul>
<nav class="links">
    <a class="button primary" href="/today">Done</a>
    <a class="button" href="/train/sessions/@session.Id">Edit</a>
</nav>
