@model GymTracker.Web.Features.Onboarding.SetupFormModel
@using GymTracker.Core.Nutrition
@{
    var d = Model.Draft;
    var year = Model.CurrentYear;
}
<form method="post" asp-antiforgery="true" action="/welcome/finish" class="setup-form" data-busy data-setup-form>
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
    <input type="hidden" name="timeZoneId" value="" data-time-zone />
    @if (Model.Summary)
    {
        <section class="section">
            <h2 class="section-title">@L["Your summary"]</h2>
            @if (Model.Preview is { } p)
            {
                <div class="card card-pad setup-preview">
                    <p class="setup-preview-main"><span class="num">@p.TargetKcal</span> <small>@L["kcal a day"]</small></p>
                    <p class="footnote">@(p.TargetKcal == p.MaintenanceKcal
                        ? L["Your starting maintenance is about {0} kcal, with {1} g of protein. It adapts as you log food and weight.", p.MaintenanceKcal, p.ProteinG ?? 0]
                        : L["From a starting maintenance of about {0} kcal, with {1} g of protein. It adapts as you log food and weight.", p.MaintenanceKcal, p.ProteinG ?? 0])</p>
                    @if (p.Macros is { } m)
                    {
                        <p class="footnote">@L["Protein at least {0} g, aiming for {1} g; fat {2}–{3} g; carbs {4}–{5} g.", m.ProteinMinG, m.ProteinAimG, m.FatMinG, m.FatMaxG, m.CarbsMinG, m.CarbsMaxG]</p>
                    }
                    @if (p.FloorApplied)
                    {
                        <p class="footnote">@L["Raised to the minimum for your sex."]</p>
                    }
                </div>
            }
            <p class="section-footer">@L["Check the details and change anything that's off. Nothing is saved until you tap Save."]</p>
        </section>
    }

    <section class="section">
        <h2 class="section-title">@L["About you"]</h2>
        <div class="list">
            <div class="field-row"><label for="setup-name">@L["Name"]</label><input id="setup-name" type="text" name="displayName" value="@d.Name" maxlength="@ProfileLimits.MaxNameLength" required autocomplete="name" /></div>
            <div class="field-row stacked">
                <span class="field-label">@L["Sex"]</span>
                <div class="segmented tall" role="radiogroup" aria-label="@L["Sex"]">
                    <label class="segment"><input type="radio" name="sex" value="Male" checked="@(d.Sex == Sex.Male)" required />@L["Male"]</label>
                    <label class="segment"><input type="radio" name="sex" value="Female" checked="@(d.Sex == Sex.Female)" />@L["Female"]</label>
                </div>
            </div>
            <div class="field-row"><label for="setup-born">@L["Birth year"]</label><input id="setup-born" class="num" type="number" name="birthYear" value="@d.BirthYear" min="@ProfileLimits.MinBirthYear(year)" max="@ProfileLimits.MaxBirthYear(year)" inputmode="numeric" required /></div>
            <div class="field-row"><label for="setup-height">@L["Height"]</label><input id="setup-height" class="num" type="number" name="heightCm" value="@d.HeightCm" min="@ProfileLimits.MinHeightCm" max="@ProfileLimits.MaxHeightCm" inputmode="numeric" required /><span class="unit">@L["cm"]</span></div>
            <div class="field-row"><label for="setup-weight">@L["Weight"]</label><input id="setup-weight" class="num" type="text" name="weightKg" value="@d.WeightKg?.Kg()" min="@ProfileLimits.MinWeightKg.Kg()" max="@ProfileLimits.MaxWeightKg.Kg()" step="any" inputmode="decimal" pattern="[0-9]*[.,]?[0-9]*" autocomplete="off" required /><span class="unit">@L["kg"]</span></div>
        </div>
    </section>

    <section class="section">
        <h2 class="section-title">@L["Activity"]</h2>
        <div class="list" role="radiogroup" aria-label="@L["Activity level"]">
            @foreach (var level in Enum.GetValues<ActivityLevel>())
            {
                <label class="row choice-row">
                    <input type="radio" name="activityLevel" value="@level" checked="@(d.ActivityLevel == level)" required />
                    <span class="choice-text"><span class="row-title">@L.Enum(level)</span><span class="row-sub">@L[ActivityLevels.Description(level)]</span></span>
                    @Ui.Icon("check", "choice-check")
                </label>
            }
        </div>
        <p class="section-footer">@L[ActivityLevels.Note]</p>
    </section>

    <section class="section">
        <h2 class="section-title">@L["Goal"]</h2>
        <div class="list">
            <div class="field-row stacked">
                <div class="segmented tall" role="radiogroup" aria-label="@L["Goal"]">
                    @foreach (var goal in Enum.GetValues<Goal>())
                    {
                        <label class="segment"><input type="radio" name="goal" value="@goal" checked="@((d.Goal ?? Goal.Maintain) == goal)" required />@L.Enum(goal)</label>
                    }
                </div>
            </div>
            <div class="field-row" data-rate-row><label for="setup-rate">@L["Rate per week"]</label><input id="setup-rate" class="num" type="text" name="targetRatePercentPerWeek" value="@d.RatePercentPerWeek?.Kg()" min="0" max="@ProfileLimits.MaxCutRatePercent.Kg()" step="0.05" inputmode="decimal" pattern="[0-9]*[.,]?[0-9]*" autocomplete="off" data-hint-cut="0.5" data-hint-bulk="0.25" /><span class="unit">@L["% of weight"]</span></div>
            <div class="field-row"><label for="setup-protein">@L["Protein"]</label><input id="setup-protein" class="num" type="text" name="proteinGramsPerKg" value="@d.ProteinGramsPerKg?.Kg()" placeholder="@L["Auto"]" min="@ProfileLimits.MinProteinGramsPerKg.Kg()" max="@ProfileLimits.MaxProteinGramsPerKg.Kg()" step="0.1" inputmode="decimal" pattern="[0-9]*[.,]?[0-9]*" autocomplete="off" /><span class="unit">@L["g per kg"]</span></div>
            <div class="field-row"><label for="setup-maintenance">@L["Starting maintenance"]</label><input id="setup-maintenance" class="num" type="number" name="initialMaintenanceKcal" value="@d.StartingMaintenanceKcal" min="@ProfileLimits.MinMaintenanceKcal" max="@ProfileLimits.MaxMaintenanceKcal" inputmode="numeric" placeholder="@L["Estimate"]" /><span class="unit">@L["kcal"]</span></div>
        </div>
        <p class="section-footer">@L["Cuts are capped at 1% and bulks at 0.5% of bodyweight per week; the rate is ignored for maintain. Leave starting maintenance empty unless you know it from tracking."]</p>
    </section>

    <button type="submit" class="btn btn-primary btn-block">@L["Save"]</button>
</form>
