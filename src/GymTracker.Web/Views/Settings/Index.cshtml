@model UserProfile
@using GymTracker.Web.Integrations
@{
    ViewData["Title"] = L["Settings"];
    var geminiKey = (GeminiKeyStatus)ViewData["GeminiKey"]!;
}
<header class="page-head">
    <h1 class="large-title">@L["Settings"]</h1>
</header>

<form method="post" asp-antiforgery="true" action="/settings/appearance" data-autosubmit>
    <section class="section">
        <h2 class="section-title">@L["Appearance"]</h2>
        <div class="list">
            <div class="field-row stacked">
                <span class="field-label">@L["Theme"]</span>
                <div class="segmented tall" role="radiogroup" aria-label="@L["Theme"]">
                    @foreach (var theme in new[] { Theme.Dark, Theme.Light, Theme.System })
                    {
                        <label class="segment"><input type="radio" name="theme" value="@theme" checked="@(Model.Theme == theme)" data-theme-preview="@theme.ToString().ToLowerInvariant()" />@L[theme == Theme.System ? "Match phone" : theme.ToString()]</label>
                    }
                </div>
            </div>
            <div class="field-row stacked">
                <span class="field-label">@L["Language"]</span>
                <div class="segmented tall" role="radiogroup" aria-label="@L["Language"]">
                    <label class="segment"><input type="radio" name="language" value="English" checked="@(Model.Language == Language.English)" />English</label>
                    <label class="segment" lang="bg"><input type="radio" name="language" value="Bulgarian" checked="@(Model.Language == Language.Bulgarian)" />Български</label>
                </div>
            </div>
        </div>
        <noscript><button type="submit" class="btn btn-secondary btn-block" style="margin-top: var(--s-3)">@L["Save"]</button></noscript>
        <p class="section-footer">@L["Saved for your account, so every phone you sign in on looks the same."]</p>
    </section>
</form>

<form method="post" asp-antiforgery="true" action="/settings/profile">
    <section class="section">
        <h2 class="section-title">@L["Profile"]</h2>
        <div class="list">
            <div class="row"><span class="row-main">@L["Email"]</span><span class="row-value row-ellipsis">@ViewData["Email"]</span></div>
            <div class="field-row"><label for="displayName">@L["Name"]</label><input id="displayName" type="text" name="displayName" value="@Model.DisplayName" maxlength="100" required autocomplete="name" /></div>
            <div class="field-row">
                <label for="sex">@L["Sex"]</label>
                <select id="sex" name="sex">
                    <option value="" selected="@(Model.Sex is null)">@L["Not set"]</option>
                    <option value="Male" selected="@(Model.Sex == Sex.Male)">@L["Male"]</option>
                    <option value="Female" selected="@(Model.Sex == Sex.Female)">@L["Female"]</option>
                </select>
            </div>
            <div class="field-row"><label for="birthYear">@L["Birth year"]</label><input id="birthYear" class="num" type="number" name="birthYear" value="@Model.BirthYear" min="1920" max="2015" inputmode="numeric" /></div>
            <div class="field-row"><label for="heightCm">@L["Height"]</label><input id="heightCm" class="num" type="number" name="heightCm" value="@Model.HeightCm" min="120" max="230" inputmode="numeric" /><span class="unit">@L["cm"]</span></div>
            <div class="field-row"><label for="initialMaintenanceKcal">@L["Starting maintenance"]</label><input id="initialMaintenanceKcal" class="num" type="number" name="initialMaintenanceKcal" value="@Model.InitialMaintenanceKcal" min="1200" max="6000" inputmode="numeric" placeholder="@L["Estimate"]" /><span class="unit">@L["kcal"]</span></div>
        </div>
        <p class="section-footer">@L["Leave starting maintenance empty to estimate it from sex, height, age and weight. It adapts to your logged data later."]</p>
    </section>

    <section class="section">
        <h2 class="section-title">@L["Goal"]</h2>
        <div class="list">
            <div class="field-row">
                <label for="goal">@L["Goal"]</label>
                <select id="goal" name="goal">
                    @foreach (var goal in Enum.GetValues<Goal>())
                    {
                        <option value="@goal" selected="@(goal == Model.Goal)">@L.Enum(goal)</option>
                    }
                </select>
            </div>
            <div class="field-row"><label for="rate">@L["Rate per week"]</label><input id="rate" class="num" type="number" name="targetRatePercentPerWeek" value="@Model.TargetRatePercentPerWeek.Kg()" min="0" max="1" step="0.05" inputmode="decimal" /><span class="unit">@L["% of weight"]</span></div>
            <div class="field-row"><label for="protein">@L["Protein"]</label><input id="protein" class="num" type="number" name="proteinGramsPerKg" value="@Model.ProteinGramsPerKg.Kg()" min="0.8" max="3.5" step="0.1" inputmode="decimal" /><span class="unit">@L["g per kg"]</span></div>
            <div class="field-row"><label for="increment">@L["Weight jump"]</label><input id="increment" class="num" type="number" name="defaultWeightIncrementKg" value="@Model.DefaultWeightIncrementKg.Kg()" min="0.25" max="20" step="any" inputmode="decimal" /><span class="unit">@L["kg"]</span></div>
            <div class="field-row"><label for="timeZoneId">@L["Time zone"]</label><input id="timeZoneId" type="text" name="timeZoneId" value="@Model.TimeZoneId" maxlength="64" autocapitalize="off" spellcheck="false" /></div>
        </div>
        <p class="section-footer">@L["Cuts are capped at 1% and bulks at 0.5% of bodyweight per week. The weight jump is how much is added when every set reaches the top of its range."]</p>
        <button type="submit" class="btn btn-primary btn-block" style="margin-top: var(--s-4)">@L["Save profile"]</button>
    </section>
</form>

<section class="section">
    <h2 class="section-title">@L["Food text parser"]</h2>
    <div class="list">
        <div class="row">
            <span class="row-icon neutral">@Ui.Icon("key")</span>
            <span class="row-main">
                <span class="row-title">
                    @switch (geminiKey.Source)
                    {
                        case KeySource.Settings:
                            @L["Gemini, with the key saved here"]
                            break;
                        case KeySource.Environment:
                            @L["Gemini, with the key from the server"]
                            break;
                        default:
                            @L["No Gemini key"]
                            break;
                    }
                </span>
                @if (geminiKey.Last4 is not null)
                {
                    <span class="row-sub" style="display: block">@L["Key ending {0}", geminiKey.Last4]</span>
                }
            </span>
        </div>
        <form method="post" asp-antiforgery="true" action="/settings/gemini-key">
            <div class="field-row stacked">
                <label for="apiKey" class="sr-only">@L["New key"]</label>
                <input id="apiKey" type="password" name="apiKey" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="@GeminiKeyStore.MaxLength" required placeholder="@L["Paste a new key"]" />
            </div>
            <div class="row" style="padding-top: 0; padding-bottom: 0"><button type="submit" class="btn btn-plain" style="padding: 0">@L["Save and test key"]</button></div>
        </form>
        @if (geminiKey.Source != KeySource.None)
        {
            <form method="post" asp-antiforgery="true" action="/settings/gemini-key/test" class="row" style="padding-top: 0; padding-bottom: 0">
                <button type="submit" class="btn btn-plain" style="padding: 0">@L["Test key"]</button>
            </form>
            @if (geminiKey.Source == KeySource.Settings)
            {
                <form method="post" asp-antiforgery="true" action="/settings/gemini-key/remove" class="row" style="padding-top: 0; padding-bottom: 0">
                    <button type="submit" class="btn btn-plain" style="padding: 0; color: var(--destructive)">@L["Remove key"]</button>
                </form>
            }
        }
    </div>
    <p class="section-footer">
        @(geminiKey.Source switch
        {
            KeySource.Environment => L["A key saved here replaces the one from the server's .env file."],
            KeySource.None => L["Without a key, typed food is split up by a simple built-in parser."],
            _ => L["Typed food is read by Gemini; the numbers come from the food database."],
        })
        @L["The key is shared by both accounts and stored encrypted."]
    </p>
</section>

<section class="section">
    <h2 class="section-title">@L["Your data"]</h2>
    <div class="list">
        <a class="row row-link" href="/settings/export" download>
            <span class="row-icon neutral">@Ui.Icon("download")</span>
            <span class="row-main">@L["Export all data"]</span>
            @Ui.Icon("chevron", "row-chevron")
        </a>
    </div>
    <p class="section-footer">@L["Workouts, sets, templates, weigh-ins, food log and targets as CSV files in a zip."]</p>
</section>

<form method="post" asp-antiforgery="true" action="/settings/password">
    <section class="section">
        <h2 class="section-title">@L["Password"]</h2>
        <div class="list">
            <div class="field-row"><label for="currentPassword">@L["Current"]</label><input id="currentPassword" type="password" name="currentPassword" autocomplete="current-password" required /></div>
            <div class="field-row"><label for="newPassword">@L["New"]</label><input id="newPassword" type="password" name="newPassword" autocomplete="new-password" minlength="12" required placeholder="@L["12+ characters"]" /></div>
            <div class="field-row"><label for="confirmPassword">@L["Repeat new"]</label><input id="confirmPassword" type="password" name="confirmPassword" autocomplete="new-password" minlength="12" required /></div>
        </div>
        <button type="submit" class="btn btn-secondary btn-block" style="margin-top: var(--s-4)">@L["Change password"]</button>
    </section>
</form>

<section class="section">
    <div class="list">
        <form method="post" asp-antiforgery="true" action="/account/logout" class="row" style="padding-top: 0; padding-bottom: 0">
            <button type="submit" class="btn btn-plain" style="padding: 0">@Ui.Icon("logout")@L["Log out"]</button>
        </form>
        <form method="post" asp-antiforgery="true" action="/settings/logout-everywhere" class="row" style="padding-top: 0; padding-bottom: 0" onsubmit="return confirm(this.dataset.confirm)" data-confirm="@L["Sign out on every device, including this one?"]">
            <button type="submit" class="btn btn-plain" style="padding: 0; color: var(--destructive)">@L["Log out everywhere"]</button>
        </form>
    </div>
</section>
