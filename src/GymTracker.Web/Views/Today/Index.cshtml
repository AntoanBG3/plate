@model TodayViewModel
@{ ViewData["Title"] = "Today"; }
<h1>Hi, @Model.DisplayName</h1>
<p class="muted">@Model.Today.ToString("dddd, d MMMM", System.Globalization.CultureInfo.InvariantCulture)</p>

@{
    var t = Model.Targets;
    var eaten = Model.Eaten;
    int Pct(decimal value, int? target) => target is > 0 ? (int)Math.Min(100, value * 100 / target.Value) : 0;
}
<a class="card nutrition-card" href="/food">
    @if (t.Kcal is { } kcal)
    {
        var left = kcal - (int)Math.Round(eaten.Kcal);
        <div class="row-between">
            <span><span class="big">@Math.Abs(left)</span> <span class="muted">kcal @(left >= 0 ? "left" : "over")</span></span>
            <span class="muted">@Math.Round(eaten.Kcal) of @kcal</span>
        </div>
        <div class="meter@(left < 0 ? " over" : "")"><div style="width: @Pct(eaten.Kcal, kcal)%"></div></div>
    }
    @if (t.ProteinG is { } protein)
    {
        var leftP = protein - (int)Math.Round(eaten.ProteinG);
        <div class="row-between">
            <span><span class="big sky">@Math.Max(0, leftP)</span> <span class="muted">g protein left</span></span>
            <span class="muted">@Math.Round(eaten.ProteinG) of @protein g</span>
        </div>
        <div class="meter sky"><div style="width: @Pct(eaten.ProteinG, protein)%"></div></div>
    }
    @if (t.Missing is not null)
    {
        <p class="muted">@t.Missing</p>
    }
    @if (t.FloorApplied)
    {
        <p class="muted warn">Raised to the @t.FloorKcal kcal minimum. Consider a slower rate in Settings.</p>
    }
    @if (t.Estimate is { } estimate)
    {
        if (estimate.Method == GymTracker.Core.Domain.MaintenanceMethod.Adaptive)
        {
            <p class="muted">
                Maintenance @estimate.EstimatedTdeeKcal kcal, adaptive from @estimate.DaysOfData days of data.
                @if (estimate.LowConfidence)
                {
                    <span class="warn">Low confidence: weigh-ins had a gap of 3 or more days.</span>
                }
            </p>
        }
        else
        {
            <p class="muted">
                Maintenance @estimate.EstimatedTdeeKcal kcal, initial estimate@(estimate.DaysOfData > 0 ? $" ({estimate.DaysOfData} days of data, food logged on {(int)Math.Round(estimate.LoggingCompleteness * 100)}%)" : "").
                It adapts weekly once you have 2 weeks of weigh-ins on most days and food logged on 80% of days.
            </p>
        }
    }
</a>

<section class="card">
    <h2>Weight</h2>
    <form method="post" asp-antiforgery="true" action="/today/weight" class="inline">
        <input type="number" name="weightKg" inputmode="decimal" step="any" min="20" max="400"
               placeholder="kg" aria-label="Weight in kg" required
               value="@(Model.TodayWeight?.WeightKg.Kg())" @(Model.TodayWeight is null ? "autofocus" : "") />
        <button type="submit" class="primary">@(Model.TodayWeight is null ? "Save" : "Update")</button>
    </form>
    @if (Model.TodayWeight is not null)
    {
        <p class="muted">Logged today: @Model.TodayWeight.WeightKg.Kg() kg@(t.TrendWeightKg is { } trendToday ? $", trend {trendToday.Kg(1)} kg" : "")</p>
    }
    else if (Model.LatestWeight is not null)
    {
        <p class="muted">Last: @Model.LatestWeight.WeightKg.Kg() kg on @Model.LatestWeight.Date.ToString("d MMM", System.Globalization.CultureInfo.InvariantCulture)@(t.TrendWeightKg is { } trendLast ? $", trend {trendLast.Kg(1)} kg" : "")</p>
    }
</section>

<section class="card highlight">
    <h2>Workout</h2>
    @if (Model.ActiveSession is not null)
    {
        <p>@(Model.ActiveSession.Template?.Name ?? "Freestyle") is in progress.</p>
        <a class="button primary" href="/train/sessions/@Model.ActiveSession.Id">Resume</a>
    }
    else if (Model.NextTemplate is not null)
    {
        <p>Next up: <strong>@Model.NextTemplate.Name</strong></p>
        <form method="post" asp-antiforgery="true" action="/train/start">
            <input type="hidden" name="templateId" value="@Model.NextTemplate.Id" />
            <button type="submit" class="primary">Start</button>
        </form>
    }
    else
    {
        <p class="muted">No templates yet.</p>
        <a class="button" href="/train/templates">Create a template</a>
    }
</section>
