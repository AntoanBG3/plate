@model GymTracker.Core.Domain.WeeklySummary
<section class="card card-pad weekly-summary" aria-labelledby="weekly-title">
    <p class="footnote" id="weekly-title">@L["Last week · {0}–{1}", Ui.DayMonth(Model.WeekStart), Ui.DayMonth(Model.WeekStart.AddDays(6))]</p>
    <p class="weekly-text">@Model.Summary</p>
    @if (Model.Tips.Count > 0)
    {
        <ul class="weekly-tips">
            @foreach (var tip in Model.Tips)
            {
                <li>@tip</li>
            }
        </ul>
    }
    @if (Model.Motivation.Length > 0)
    {
        <p class="weekly-motivation">@Model.Motivation</p>
    }
    <p class="caption">@L["Written by AI from your numbers. Turn it off in Settings."]</p>
</section>
