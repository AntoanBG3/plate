@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["HideTabs"] = true;
}
<h1>Sign in</h1>
@if (Model.Error is not null)
{
    <p class="error" role="alert">@Model.Error</p>
}
<form method="post" asp-antiforgery="true" action="/account/login" class="stack">
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
    <label>Email
        <input type="email" name="email" value="@Model.Email" autocomplete="username" autocapitalize="none" required autofocus />
    </label>
    <label>Password
        <input type="password" name="password" autocomplete="current-password" required />
    </label>
    <button type="submit" class="primary">Sign in</button>
</form>
