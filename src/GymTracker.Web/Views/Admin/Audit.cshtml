@model List<AdminAuditRow>
@{
    ViewData["Title"] = "Audit";
    ViewData["BackUrl"] = "/admin";
    ViewData["BackLabel"] = "Admin";
}
<header class="page-head">
    <h1 class="large-title">Audit</h1>
</header>
<partial name="_AdminNav" />

<section class="section">
    <div class="list">
        @foreach (var a in Model)
        {
            var e = a.Entry;
            <div class="row">
                <span class="row-main">
                    <span class="row-title">@e.Action@(e.Target is null ? "" : $" · {e.Target}")</span>
                    <span class="row-sub admin-text" style="display: block">@e.At.ToUniversalTime().ToString("d MMM HH:mm") UTC · @(e.Via == GymTracker.Web.Data.AdminVia.Cli ? "CLI" : a.Email ?? "web")@(e.Ip is null ? "" : $" · {e.Ip}")@(e.Detail is null ? "" : $" · {e.Detail}")</span>
                </span>
            </div>
        }
        @if (Model.Count == 0)
        {
            <div class="row"><span class="row-main footnote">Nothing yet.</span></div>
        }
    </div>
    <p class="section-footer">The latest 200 entries. Over SSH: admin audit --since 30d.</p>
</section>
