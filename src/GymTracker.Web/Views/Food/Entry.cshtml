@model FoodLogEntry
@{
    ViewData["Title"] = "Edit food";
    var date = Model.Date.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
}
<p class="muted"><a href="/food?date=@date">← Back</a></p>
<h1>Edit</h1>
<form method="post" asp-antiforgery="true" action="/food/entries/@Model.Id" class="card stack">
    <label>Description <input type="text" name="description" value="@Model.Description" maxlength="200" required /></label>
    <label>Grams <input type="number" name="grams" value="@Model.Grams.Kg()" min="1" max="3000" step="any" inputmode="decimal" required /></label>
    <label>Meal
        <select name="meal">
            @foreach (var meal in Enum.GetValues<Meal>())
            {
                <option value="@meal" selected="@(meal == Model.Meal)">@meal</option>
            }
        </select>
    </label>
    <p class="muted">Now @Math.Round(Model.Kcal) kcal · @Model.ProteinG.Kg() g protein · @Model.CarbsG.Kg() g carbs · @Model.FatG.Kg() g fat. Changing grams scales these.</p>
    <button type="submit" class="primary">Save</button>
</form>
<form method="post" asp-antiforgery="true" action="/food/entries/@Model.Id/delete" onsubmit="return confirm('Delete this entry?')">
    <button type="submit" class="danger">Delete</button>
</form>
