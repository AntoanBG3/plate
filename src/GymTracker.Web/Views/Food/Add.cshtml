@model FoodAddViewModel
@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var date = Model.Date.ToString("yyyy-MM-dd", inv);
    var title = L[AddTo[Model.Meal]];
    ViewData["Title"] = title;
    ViewData["BackUrl"] = $"/food?date={date}";
    ViewData["BackLabel"] = L["Food"];
    string TabUrl(string tab) => $"/food/add?date={date}&meal={Model.Meal}&tab={tab}";
    string TabClass(string tab) => tab == Model.Tab ? "segment is-active" : "segment";
    string? Current(string tab) => tab == Model.Tab ? "page" : null;
}
<header class="page-head">
    <p class="eyebrow">@Ui.ShortDate(Model.Date)</p>
    <h1 class="large-title">@title</h1>
</header>

<nav class="segmented tall" data-thumb aria-label="@L["How to add"]" style="margin-bottom: var(--s-5)">
    <a class="@TabClass("text")" href="@TabUrl("text")" aria-current="@Current("text")">@L["Type"]</a>
    <a class="@TabClass("barcode")" href="@TabUrl("barcode")" aria-current="@Current("barcode")">@L["Scan"]</a>
    <a class="@TabClass("search")" href="@TabUrl("search")" aria-current="@Current("search")">@L["Search"]</a>
    <a class="@TabClass("recent")" href="@TabUrl("recent")" aria-current="@Current("recent")">@L["Recent"]</a>
    <a class="@TabClass("manual")" href="@TabUrl("manual")" aria-current="@Current("manual")">@L["Manual"]</a>
</nav>

@if (Model.Error is not null)
{
    <div class="banner is-error" role="alert">@Ui.Icon("alert")<span>@L[Model.Error]</span></div>
}

@switch (Model.Tab)
{
    case "text":
        <form method="post" asp-antiforgery="true" action="/food/parse" data-busy>
            <input type="hidden" name="date" value="@date" />
            <input type="hidden" name="meal" value="@Model.Meal" />
            <div class="composer">
                <label for="text" class="sr-only">@L["What did you eat?"]</label>
                <textarea id="text" name="text" rows="1" maxlength="1000" placeholder="@L["What did you eat?"]" autofocus required>@Model.Text</textarea>
                <button type="submit" class="send-btn" aria-label="@L["Read it"]">@Ui.Icon("send")</button>
            </div>
            <p class="composer-hint footnote">@L["For example: 200 g chicken breast, 150 g cooked rice, a banana. English or Bulgarian. You check every item before anything is saved."]</p>
            <p class="thinking" role="status"><i></i><i></i><i></i><span>@L["Reading…"]</span></p>
        </form>
        @if (Model.Error is not null)
        {
            <a class="btn btn-secondary btn-block" style="margin-top: var(--s-5)" href="@TabUrl("manual")">@L["Enter it by hand instead"]</a>
        }
        break;

    case "barcode":
        <div class="btn-stack">
            <button type="button" class="btn btn-primary" data-start>@Ui.Icon("barcode")@L["Scan a barcode"]</button>
        </div>
        <form method="get" action="/food/barcode" id="barcode-form" class="section" style="margin-top: var(--s-6)">
            <input type="hidden" name="date" value="@date" />
            <input type="hidden" name="meal" value="@Model.Meal" />
            <h2 class="section-header">@L["Or type the digits"]</h2>
            <div class="list">
                <div class="field-row">
                    <label for="code" class="sr-only">@L["Barcode digits"]</label>
                    <input id="code" class="num" type="text" name="code" inputmode="numeric" pattern="[0-9]{8,14}" placeholder="@L["8 to 14 digits"]" required style="text-align: left; flex: 1; color: var(--label)" />
                    <button type="submit" class="btn btn-plain">@L["Look up"]</button>
                </div>
            </div>
        </form>
        <p class="section-footer">@L["The camera may ask for permission each time the app opens."]</p>
        break;

    case "search":
        <form method="get" action="/food/add">
            <input type="hidden" name="date" value="@date" />
            <input type="hidden" name="meal" value="@Model.Meal" />
            <input type="hidden" name="tab" value="search" />
            <div class="search-field">
                @Ui.Icon("search")
                <input type="search" class="input" name="q" value="@Model.Query" placeholder="@L["Oats, skyr, кашкавал…"]" aria-label="@L["Search foods"]" autofocus enterkeyhint="search" />
            </div>
        </form>
        @if (!string.IsNullOrWhiteSpace(Model.Query))
        {
            @if (Model.Local.Count > 0)
            {
                <section class="section" style="margin-top: var(--s-5)">
                    <h2 class="section-header">@L["Saved foods"]</h2>
                    <div class="list">
                        @foreach (var f in Model.Local)
                        {
                            <form method="post" asp-antiforgery="true" action="/food/log-item" class="portion" data-per100="@f.KcalPer100g.Kg(),@f.ProteinPer100g.Kg()">
                                <input type="hidden" name="date" value="@date" />
                                <input type="hidden" name="meal" value="@Model.Meal" />
                                <input type="hidden" name="foodItemId" value="@f.Id" />
                                <input type="hidden" name="source" value="Search" />
                                <div class="row-title headline">@f.DisplayName</div>
                                <div class="row-sub">@(f.Brand is null ? "" : f.Brand + " · ")@L["{0} kcal, {1} g protein per 100 g", Math.Round(f.KcalPer100g), f.ProteinPer100g.Kg(1)]</div>
                                <div class="portion-line">
                                    <label class="grams"><input type="number" name="grams" value="@((f.DefaultServingGrams ?? 100).Kg())" min="1" max="3000" step="any" inputmode="decimal" aria-label="@L["Grams"]" required /><span class="footnote">@L["g"]</span></label>
                                    @{ var serving = f.DefaultServingGrams ?? 100; }
                                    <span class="footnote num" data-totals>@L["{0} kcal · {1} g protein", Math.Round(f.KcalPer100g * serving / 100), (f.ProteinPer100g * serving / 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)]</span>
                                    <button type="submit" class="btn btn-tinted btn-small">@L["Add"]</button>
                                </div>
                            </form>
                        }
                    </div>
                </section>
            }
            @if (Model.OpenFoodFacts is null)
            {
                <div class="section" style="margin-top: var(--s-5)">
                    @if (Model.Local.Count == 0)
                    {
                        <p class="subhead" style="margin: 0 var(--s-4) var(--s-3)">@L["Nothing saved matches."]</p>
                    }
                    <a class="btn btn-secondary btn-block" href="/food/add?date=@date&amp;meal=@Model.Meal&amp;tab=search&amp;q=@Uri.EscapeDataString(Model.Query)&amp;off=true">@Ui.Icon("search")@L["Search Open Food Facts"]</a>
                </div>
            }
            else if (Model.OpenFoodFacts.Status == GymTracker.Core.Nutrition.LookupStatus.RateLimited)
            {
                <div class="banner is-error" style="margin-top: var(--s-5)">@Ui.Icon("clock")<span>@L["Open Food Facts is limiting requests right now. Try again in a minute."]</span></div>
            }
            else if (Model.OpenFoodFacts.Status != GymTracker.Core.Nutrition.LookupStatus.Found)
            {
                <div class="banner is-error" style="margin-top: var(--s-5)">@Ui.Icon("alert")<span>@L["Open Food Facts didn't answer. Try again later, or add the food by hand."]</span></div>
            }
            else
            {
                <section class="section" style="margin-top: var(--s-5)">
                    <h2 class="section-header">Open Food Facts</h2>
                    @{ var products = Model.OpenFoodFacts.Products.Where(p => GymTracker.Core.Nutrition.Barcodes.IsValid(p.Barcode)).ToList(); }
                    @if (products.Count == 0)
                    {
                        <p class="subhead" style="margin: 0 var(--s-4)">@L["No products with nutrition data found."]</p>
                    }
                    else
                    {
                        <div class="list">
                            @foreach (var p in products)
                            {
                                <a class="row row-link" href="/food/barcode?date=@date&amp;meal=@Model.Meal&amp;code=@p.Barcode">
                                    <span class="row-main">
                                        <span class="row-title" style="display: block">@p.Name</span>
                                        <span class="row-sub" style="display: block">@(p.Brand is null ? "" : p.Brand + " · ")@L["{0} kcal per 100 g", Math.Round(p.Per100.Kcal)]</span>
                                    </span>
                                    @Ui.Icon("chevron", "row-chevron")
                                </a>
                            }
                        </div>
                    }
                </section>
            }
        }
        break;

    case "recent":
        @if (Model.Recents.Count == 0)
        {
            <div class="card empty">
                <div class="empty-icon">@Ui.Icon("history")</div>
                <h2>@L["Nothing recent yet"]</h2>
                <p>@L["Foods you log in the next 30 days show up here for one-tap logging."]</p>
            </div>
        }
        else
        {
            <div class="list">
                @foreach (var r in Model.Recents)
                {
                    <form method="post" asp-antiforgery="true" action="/food/log-recent" class="portion" data-per100="@r.Per100.Kcal.Kg(),@r.Per100.Protein.Kg()">
                        <input type="hidden" name="date" value="@date" />
                        <input type="hidden" name="meal" value="@Model.Meal" />
                        <input type="hidden" name="description" value="@r.Description" />
                        <input type="hidden" name="foodItemId" value="@r.FoodItemId" />
                        <input type="hidden" name="kcal" value="@r.Per100.Kcal.Kg()" />
                        <input type="hidden" name="protein" value="@r.Per100.Protein.Kg()" />
                        <input type="hidden" name="carbs" value="@r.Per100.Carbs.Kg()" />
                        <input type="hidden" name="fat" value="@r.Per100.Fat.Kg()" />
                        <div class="row-title headline">@r.Description</div>
                        <div class="portion-line">
                            <label class="grams"><input type="number" name="grams" value="@r.LastGrams.Kg()" min="1" max="3000" step="any" inputmode="decimal" aria-label="@L["Grams"]" required /><span class="footnote">@L["g"]</span></label>
                            <span class="footnote" data-totals>@L.Count(r.Times, "logged once in 30 days", "logged {0}× in 30 days")</span>
                            <button type="submit" class="btn btn-tinted btn-small">@L["Add"]</button>
                        </div>
                    </form>
                }
            </div>
        }
        break;

    default:
        <partial name="_ManualFoodForm" model="(Model.Date, Model.Meal, (string?)null, Model.Text)" />
        break;
}

@section Overlays {
    @if (Model.Tab == "barcode")
    {
        <div class="sheet" id="scanner" data-module="scanner" hidden>
            <div class="sheet-scrim"></div>
            <div class="sheet-panel full scanner-panel" role="dialog" aria-modal="true" aria-labelledby="scanner-title">
                <div class="sheet-grabber" aria-hidden="true" style="background: rgb(255 255 255 / 0.4)"></div>
                <div class="sheet-head"><span></span><span class="sheet-title" id="scanner-title">@L["Scan a barcode"]</span><button type="button" class="sheet-close" data-sheet-close>@L["Cancel"]</button></div>
                <div class="viewfinder">
                    <video playsinline muted hidden></video>
                    <div class="viewfinder-frame" aria-hidden="true"></div>
                    <p class="viewfinder-status" data-status role="status">@L["Point the camera at the barcode."]</p>
                </div>
                <div class="scanner-actions">
                    <label class="btn btn-secondary">@Ui.Icon("photo")@L["Take a photo instead"]
                        <input type="file" accept="image/*" capture="environment" data-photo class="sr-only" />
                    </label>
                </div>
            </div>
        </div>
        <script src="~/lib/barcode-detector/barcode-detector-3.2.2.ponyfill.js" asp-append-version="true"></script>
        <script src="~/js/scanner.js" asp-append-version="true"></script>
    }
}

@functions {
    private static readonly Dictionary<Meal, string> AddTo = new()
    {
        [Meal.Breakfast] = "Add to breakfast",
        [Meal.Lunch] = "Add to lunch",
        [Meal.Dinner] = "Add to dinner",
        [Meal.Snack] = "Add a snack",
    };
}
