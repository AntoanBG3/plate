@model List<GymTracker.Web.Features.Food.FoodMatch>
@{ var inv = System.Globalization.CultureInfo.InvariantCulture; }
@if (Model.Count == 0)
{
    <p class="subhead" style="margin: var(--s-4)">@L["Nothing matches."]</p>
}
else
{
    <div class="list" style="margin-top: var(--s-3)">
        @foreach (var f in Model)
        {
            @* site.js puts this food on the row the sheet was opened for. *@
            <button type="button" class="row row-link" style="width: 100%; text-align: left" data-candidate="@f.Id" data-name="@f.DisplayName"
                    data-kcal="@f.KcalPer100g.ToString(inv)" data-protein="@f.ProteinPer100g.ToString(inv)" data-carbs="@f.CarbsPer100g.ToString(inv)"
                    data-fat="@f.FatPer100g.ToString(inv)" data-fiber="@f.FiberPer100g?.ToString(inv)" data-satfat="@f.SaturatedFatPer100g?.ToString(inv)">
                <span class="row-main">
                    <span class="row-title" style="display: block">@f.DisplayName</span>
                    <span class="row-sub" style="display: block">@(f.Brand is null ? "" : f.Brand + " · ")@L["{0} kcal, {1} g protein per 100 g", Math.Round(f.KcalPer100g), f.ProteinPer100g.Kg(1)]</span>
                </span>
            </button>
        }
    </div>
}
