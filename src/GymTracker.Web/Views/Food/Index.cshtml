@model FoodDayViewModel
@{
    ViewData["Title"] = "Food";
    var day = Model.Day;
    var isToday = day.Date == Model.Today;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Iso(DateOnly d) => d.ToString("yyyy-MM-dd", inv);
}
<header class="row-between">
    <a class="button icon" href="/food?date=@Iso(day.Date.AddDays(-1))" aria-label="Previous day">←</a>
    <div class="date-title">
        <h1>@(isToday ? "Today" : day.Date.ToString("ddd d MMM", inv))</h1>
        @if (!isToday)
        {
            <a href="/food">Back to today</a>
        }
    </div>
    <a class="button icon" href="/food?date=@Iso(day.Date.AddDays(1))" aria-label="Next day">→</a>
</header>

<section class="card totals">
    <div><span class="big">@Math.Round(day.Totals.Kcal)</span><span class="muted">kcal@(isToday && Model.Targets.Kcal is { } t ? $" of {t}" : "")</span></div>
    <div><span class="big sky">@Math.Round(day.Totals.ProteinG)</span><span class="muted">g protein@(isToday && Model.Targets.ProteinG is { } p ? $" of {p}" : "")</span></div>
    <div><span class="mid">@Math.Round(day.Totals.CarbsG)</span><span class="muted">g carbs</span></div>
    <div><span class="mid">@Math.Round(day.Totals.FatG)</span><span class="muted">g fat</span></div>
</section>

@foreach (var meal in Enum.GetValues<Meal>())
{
    var entries = day.For(meal).ToList();
    var mealTotals = day.TotalsFor(meal);
    <section class="card meal">
        <div class="row-between">
            <h2>@meal</h2>
            <span class="muted">@Math.Round(mealTotals.Kcal) kcal</span>
        </div>
        @if (entries.Count > 0)
        {
            <ul class="list">
                @foreach (var e in entries)
                {
                    <li>
                        <a href="/food/entries/@e.Id" class="entry">
                            <span>@e.Description</span>
                            <span class="muted">@e.Grams.Kg() g · @Math.Round(e.Kcal) kcal · @e.ProteinG.Kg() g protein</span>
                        </a>
                    </li>
                }
            </ul>
        }
        <div class="card-actions">
            <a class="button" href="/food/add?date=@Iso(day.Date)&amp;meal=@meal">+ Add</a>
            @if (entries.Count == 0)
            {
                <form method="post" asp-antiforgery="true" action="/food/copy" class="grow">
                    <input type="hidden" name="date" value="@Iso(day.Date)" />
                    <input type="hidden" name="meal" value="@meal" />
                    <button type="submit" class="wide">Copy yesterday's</button>
                </form>
            }
        </div>
    </section>
}
