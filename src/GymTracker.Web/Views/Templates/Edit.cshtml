@model WorkoutTemplate
@{ ViewData["Title"] = Model.Name; }
<form method="post" asp-antiforgery="true" action="/train/templates/@Model.Id/rename" class="inline">
    <input type="text" name="name" value="@Model.Name" maxlength="100" required aria-label="Template name" class="title-input" />
    <button type="submit">Rename</button>
</form>

@foreach (var item in Model.Exercises)
{
    <section class="card">
        <header class="row-between">
            <h2>@item.Exercise.Name</h2>
            <span class="icon-buttons">
                <form method="post" asp-antiforgery="true" action="/train/templates/exercises/@item.Id/move"><input type="hidden" name="direction" value="-1" /><button type="submit" aria-label="Move up">↑</button></form>
                <form method="post" asp-antiforgery="true" action="/train/templates/exercises/@item.Id/move"><input type="hidden" name="direction" value="1" /><button type="submit" aria-label="Move down">↓</button></form>
                <form method="post" asp-antiforgery="true" action="/train/templates/exercises/@item.Id/remove" onsubmit="return confirm('Remove this exercise from the template?')"><button type="submit" aria-label="Remove">✕</button></form>
            </span>
        </header>
        <form method="post" asp-antiforgery="true" action="/train/templates/exercises/@item.Id" class="grid-form">
            <label>Sets <input type="number" name="workingSets" value="@item.WorkingSets" min="1" max="20" inputmode="numeric" required /></label>
            <label>Min reps <input type="number" name="repMin" value="@item.RepMin" min="1" max="100" inputmode="numeric" required /></label>
            <label>Max reps <input type="number" name="repMax" value="@item.RepMax" min="1" max="100" inputmode="numeric" required /></label>
            <label>+kg <input type="number" name="weightIncrementKg" value="@(item.WeightIncrementKg?.Kg())" step="any" min="0" inputmode="decimal" placeholder="default" /></label>
            <label>Rest (s) <input type="number" name="restSeconds" value="@item.RestSeconds" min="0" max="1800" step="15" inputmode="numeric" required /></label>
            <button type="submit">Save</button>
        </form>
    </section>
}

<a class="button" href="/train/templates/@Model.Id/add-exercise">Add exercise</a>

<form method="post" asp-antiforgery="true" action="/train/templates/@Model.Id/archive" onsubmit="return confirm('Archive this template? Past sessions keep their history.')">
    <button type="submit" class="danger">Archive template</button>
</form>
<p><a href="/train/templates">Back to templates</a></p>
