@model TemplateEditViewModel
@{
    var template = Model.Template;
    ViewData["Title"] = template.Name;
    ViewData["BackUrl"] = "/train/templates";
    ViewData["BackLabel"] = L["Templates"];
    var items = template.Exercises.OrderBy(e => e.SortOrder).ToList();
}
@section TopbarTrailing {
    @* Duplicate and Archive live here, away from Add exercise (Phase 11). *@
    <div class="menu-wrap">
        <button type="button" class="icon-btn" data-menu-trigger aria-expanded="false" aria-label="@L["Actions for {0}", template.Name]">@Ui.Icon("more")</button>
        <div class="menu" role="menu">
            <form method="post" asp-antiforgery="true" action="/train/templates/@template.Id/duplicate"><button type="submit" role="menuitem">@L["Duplicate"]@Ui.Icon("copy")</button></form>
            <form method="post" asp-antiforgery="true" action="/train/templates/@template.Id/archive" data-confirm="@L["Archive this template? Past workouts keep their history."]" data-confirm-action="@L["Archive"]"><button type="submit" role="menuitem" class="danger">@L["Archive template"]@Ui.Icon("trash")</button></form>
        </div>
    </div>
}
<header class="page-head">
    <h1 class="large-title">@template.Name</h1>
</header>

<partial name="_TemplateNameForm" model="new TemplateNameFormViewModel(template.Id, template.Name)" />

@for (var i = 0; i < items.Count; i++)
{
    var item = items[i];
    <section class="exercise" id="te-@item.Id">
        <div class="ex-head">
            <div>
                <h2 class="ex-name">@L.Exercise(item.Exercise)</h2>
                @if (Model.Settings.GetValueOrDefault(item.ExerciseId)?.Note is { } note)
                {
                    <p class="ex-note">@note</p>
                }
            </div>
            <div class="menu-wrap">
                <button type="button" class="icon-btn" data-menu-trigger aria-expanded="false" aria-label="@L["Actions for {0}", L.Exercise(item.Exercise)]">@Ui.Icon("more")</button>
                <div class="menu" role="menu">
                    @if (i > 0)
                    {
                        <form method="post" asp-antiforgery="true" action="/train/templates/exercises/@item.Id/move"><input type="hidden" name="direction" value="-1" /><button type="submit" role="menuitem">@L["Move up"]@Ui.Icon("up")</button></form>
                    }
                    @if (i < items.Count - 1)
                    {
                        <form method="post" asp-antiforgery="true" action="/train/templates/exercises/@item.Id/move"><input type="hidden" name="direction" value="1" /><button type="submit" role="menuitem">@L["Move down"]@Ui.Icon("down")</button></form>
                    }
                    <button type="button" role="menuitem" hx-get="/train/exercises/@item.ExerciseId/settings?returnUrl=@Uri.EscapeDataString($"/train/templates/{template.Id}")" hx-target="#exercise-sheet-body" hx-swap="innerHTML" data-sheet-open="exercise-sheet">@L["Notes & bar"]@Ui.Icon("pencil")</button>
                    <form method="post" asp-antiforgery="true" action="/train/templates/exercises/@item.Id/remove"><button type="submit" role="menuitem" class="danger">@L["Remove"]@Ui.Icon("trash")</button></form>
                </div>
            </div>
        </div>
        <partial name="_TemplateExerciseForm" model="new TemplateExerciseFormViewModel(item)" />
    </section>
}

<div class="btn-stack" style="margin-top: var(--s-6)">
    <a class="btn btn-secondary" href="/train/templates/@template.Id/add-exercise">@Ui.Icon("plus")@L["Add exercise"]</a>
</div>

@section Overlays {
    <partial name="_ExerciseSheet" />
}
