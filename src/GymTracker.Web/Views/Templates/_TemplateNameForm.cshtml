@model TemplateNameFormViewModel
@* The name saves when it changes, like every other field here (site.js data-autosave); the page's titles follow. *@
<form method="post" asp-antiforgery="true" action="/train/templates/@Model.TemplateId/rename" class="list@(Model.Saved ? " is-saved" : "")"
      data-autosave hx-post="/train/templates/@Model.TemplateId/rename" hx-trigger="change delay:300ms, submit" hx-sync="this:replace" hx-target="this" hx-swap="outerHTML">
    <div class="field-row">
        <label for="name">@L["Name"]</label>
        <input id="name" type="text" name="name" value="@Model.Name" maxlength="100" required />
    </div>
    @if (Model.Error is { } error)
    {
        <p class="field-error" role="alert">@Ui.Icon("alert", "icon-sm")<span>@L[error]</span></p>
    }
    <p class="autosave-status" role="status"><span data-state="saving">@L["Saving…"]</span><span data-state="saved">@Ui.Icon("check", "icon-sm")@L["Saved"]</span><span data-state="unsaved">@L["Not saved yet. It tries again when you have signal."]</span></p>
</form>
