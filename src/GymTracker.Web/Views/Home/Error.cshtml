@model int
@{
    ViewData["Title"] = Model == 404 ? L["Not found"] : L["Error"];
    var (icon, title, text) = Model switch
    {
        404 => ("search", L["Not found"], L["That page doesn't exist, or it isn't yours."]),
        429 => ("clock", L["Too many attempts"], L["Wait a few minutes and try again."]),
        413 => ("photo", L["Too large"], L["That was more than the app accepts. For a screenshot, attach it from the Send feedback page, which shrinks it first."]),
        _ => ("alert", L["Something went wrong"], L["Try again. If it keeps happening, the server may be restarting."]),
    };
}
<div class="empty" style="padding-top: 18vh">
    <div class="empty-icon">@Ui.Icon(icon)</div>
    <h1 class="large-title" style="font-size: var(--text-title-2); view-transition-name: none">@title</h1>
    <p style="margin-top: var(--s-2)">@text</p>
    <a class="btn btn-secondary" href="/today">@L["Back to Today"]</a>
    @if (Model >= 500 && User.Identity?.IsAuthenticated == true)
    {
        var trace = System.Diagnostics.Activity.Current?.TraceId.ToString() ?? Context.TraceIdentifier;
        <p class="footnote" style="margin-top: var(--s-5)">@L["Reference {0}", trace[..Math.Min(8, trace.Length)]]</p>
        <a class="btn btn-plain" href="/feedback/new?about=ErrorPage&trace=@Uri.EscapeDataString(trace)">@Ui.Icon("feedback")@L["Report this"]</a>
    }
</div>
