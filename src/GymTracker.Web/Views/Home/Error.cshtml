@model int
@{
    ViewData["Title"] = "Error";
    var text = Model switch
    {
        404 => "That page doesn't exist, or it isn't yours.",
        429 => "Too many attempts. Wait a few minutes and try again.",
        _ => "Something went wrong.",
    };
}
<h1>@(Model == 404 ? "Not found" : "Error")</h1>
<p>@text</p>
<p><a class="button" href="/today">Back to Today</a></p>
