@model CustomExerciseViewModel
@using Plate.Core.Domain
@{
    var isNew = Model.Id is null;
    ViewData["Title"] = isNew ? L["New exercise"] : Model.Name;
    // From a picker, Cancel goes back to it; otherwise to the list.
    var back = Model.AddTo is ({ } kind, var id) ? (kind == "template" ? $"/train/templates/{id}/add-exercise" : $"/train/sessions/{id}/add-exercise") : "/settings/exercises";
    ViewData["BackUrl"] = back;
    ViewData["BackLabel"] = Model.AddTo is null ? L["Custom exercises"] : L["Cancel"];
}
<header class="page-head">
    <h1 class="large-title">@(isNew ? L["New exercise"] : Model.Name)</h1>
</header>

@if (isNew)
{
    <form method="post" asp-antiforgery="true" action="/settings/exercises">
        @if (Model.AddTo is ({ } kind, var id))
        {
            <input type="hidden" name="addTo" value="@kind:@id" />
        }
        <div class="list">
            <div class="field-row"><label for="name">@L["Name"]</label><input id="name" type="text" name="name" value="@Model.Name" maxlength="60" required autocomplete="off" /></div>
            <div class="field-row">
                <label for="primary">@L["Main muscle"]</label>
                <select id="primary" name="primaryMuscle">
                    @foreach (var m in Enum.GetValues<Muscle>())
                    {
                        <option value="@m" selected="@(m == Model.PrimaryMuscle)">@L.Enum(m)</option>
                    }
                </select>
            </div>
            <div class="field-row">
                <label for="equipment">@L["Equipment"]</label>
                <select id="equipment" name="equipment">
                    @foreach (var e in Enum.GetValues<Equipment>())
                    {
                        <option value="@e" selected="@(e == Model.Equipment)">@L.Enum(e)</option>
                    }
                </select>
            </div>
            <fieldset class="field-row stacked" style="border: 0; margin: 0">
                <legend class="sr-only">@L["Also works"]</legend>
                <span aria-hidden="true">@L["Also works"]</span>
                <div class="plate-choices">
                    @foreach (var m in Enum.GetValues<Muscle>())
                    {
                        <label class="plate-choice"><input type="checkbox" name="secondaryMuscles" value="@m" checked="@Model.SecondaryMuscles.Contains(m)" /><span>@L.Enum(m)</span></label>
                    }
                </div>
            </fieldset>
        </div>
        <p class="section-footer">@L["Secondary muscles count as half a set in the weekly sets chart."]</p>
        <button type="submit" class="btn btn-primary btn-block" style="margin-top: var(--s-4)">@(Model.AddTo is null ? L["Create exercise"] : L["Create and add"])</button>
    </form>
}
else
{
    <form method="post" asp-antiforgery="true" action="/settings/exercises/@Model.Id/rename">
        <div class="list">
            <div class="field-row"><label for="name">@L["Name"]</label><input id="name" type="text" name="name" value="@Model.Name" maxlength="60" required autocomplete="off" /></div>
            <div class="row"><span class="row-main subhead">@L.Enum(Model.PrimaryMuscle) · @L.Enum(Model.Equipment)</span></div>
        </div>
        <button type="submit" class="btn btn-primary btn-block" style="margin-top: var(--s-4)">@L["Rename"]</button>
    </form>
    <form method="post" asp-antiforgery="true" action="/settings/exercises/@Model.Id/archive" data-confirm="@L["Archive this exercise? Workouts and templates that use it keep it."]" data-confirm-action="@L["Archive"]" style="margin-top: var(--s-6)">
        <button type="submit" class="btn btn-plain btn-block" style="color: var(--destructive)">@L["Archive exercise"]</button>
    </form>
}
