@model List<ChangelogEntry>
@{
    ViewData["Title"] = "What's new";
    ViewData["BackUrl"] = "/admin";
    ViewData["BackLabel"] = "Admin";
}
<header class="page-head">
    <h1 class="large-title">What's new</h1>
</header>
<partial name="_AdminNav" />

<section class="section">
    <h2 class="section-title">Add a line</h2>
    <form method="post" asp-antiforgery="true" action="/admin/changelog" class="list">
        <div class="field-row stacked">
            <label for="textEn" class="footnote">English</label>
            <textarea id="textEn" name="textEn" class="textarea" rows="2" maxlength="@ChangelogEntry.MaxTextLength" required></textarea>
        </div>
        <div class="field-row stacked">
            <label for="textBg" class="footnote">Bulgarian</label>
            <textarea id="textBg" name="textBg" class="textarea" rows="2" maxlength="@ChangelogEntry.MaxTextLength" required></textarea>
        </div>
        <div class="field-row">
            <label for="feedbackId">Report # (optional)</label>
            <input id="feedbackId" name="feedbackId" type="number" inputmode="numeric" min="1" />
        </div>
        <div class="row"><button type="submit" class="btn btn-plain" style="padding: 0">Add</button></div>
    </form>
    <p class="section-footer">Every user sees it once on Today, in their language.</p>
</section>

<section class="section">
    <h2 class="section-title">Lines</h2>
    <div class="list">
        @foreach (var c in Model)
        {
            <div class="feedback-item">
                <div class="feedback-head">
                    <span class="footnote">#@c.Id · @c.CreatedAt.ToUniversalTime().ToString("d MMM yyyy")@(c.FeedbackId is { } fid ? $" · report #{fid}" : "")@(c.Version is { } v ? $" · {v}" : "")</span>
                    <form method="post" asp-antiforgery="true" action="/admin/changelog/@c.Id/remove" data-confirm="Remove this line? Anyone who hasn't seen it yet won't.">
                        <button type="submit" class="btn btn-plain" style="color: var(--destructive)">Remove</button>
                    </form>
                </div>
                <p class="feedback-message admin-text">@c.TextEn</p>
                <p class="feedback-message footnote admin-text">@c.TextBg</p>
            </div>
        }
        @if (Model.Count == 0)
        {
            <div class="row"><span class="row-main footnote">No lines yet.</span></div>
        }
    </div>
</section>
