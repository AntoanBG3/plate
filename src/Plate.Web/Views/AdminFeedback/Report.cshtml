@model Plate.Web.Features.Feedback.FeedbackDetail
@using Plate.Web.Cli
@{
    var r = Model.Row;
    ViewData["Title"] = $"Report #{r.Id}";
    ViewData["BackUrl"] = "/admin/feedback";
    ViewData["BackLabel"] = "Reports";
    var language = Model.Context?["language"]?.ToString();
    var justFixed = Context.Request.Query["fixed"] == "1";
}
<header class="page-head">
    <h1 class="large-title">Report #@r.Id</h1>
    <p class="subhead">@r.Reporter · @r.CreatedAt.ToUniversalTime().ToString("d MMM yyyy HH:mm") UTC · @r.Source / @r.Kind / @r.Area@(language is null ? "" : $" · writes in {language}")</p>
</header>

<section class="section">
    <div class="list">
        <div class="feedback-item">
            <div class="feedback-head">
                <span class="footnote">@(r.Rating is { } rating ? $"Rated {rating.ToString().ToLowerInvariant()}" : "Message")@(r.Reasons != ParseReason.None ? ": " + r.Reasons : "")</span>
                <span class="chip@(r.Status == FeedbackStatus.Fixed ? " good" : "")">@r.Status</span>
            </div>
            <p class="feedback-message admin-text">@(r.Message ?? "(no message)")</p>
        </div>
    </div>
    @if (Model.FixedInVersion is not null || Model.StatusChangedAt is not null)
    {
        <p class="section-footer">@(Model.StatusChangedAt is { } changed ? $"Changed {changed.ToUniversalTime():d MMM HH:mm} UTC" : "")@(Model.FixedInVersion is { } v ? $", fixed in {v}" : "")</p>
    }
</section>

@if (Model.Screenshot is { } shot)
{
    <section class="section">
        <h2 class="section-title">Screenshot</h2>
        <a href="/admin/feedback/@r.Id/screenshot" target="_blank" rel="noopener" class="list admin-shot">
            <img src="/admin/feedback/@r.Id/screenshot" width="@shot.Width" height="@shot.Height" alt="Screenshot attached to report @r.Id" loading="lazy" />
        </a>
        <p class="section-footer">@shot.ContentType, @(shot.Width)×@shot.Height, @(shot.Bytes / 1024) KB</p>
    </section>
}

<section class="section">
    <h2 class="section-title">Status and reply</h2>
    <form method="post" asp-antiforgery="true" action="/admin/feedback/@r.Id/status" class="list">
        <div class="field-row">
            <label for="status">Status</label>
            <select id="status" name="status">
                @foreach (var s in Enum.GetValues<FeedbackStatus>())
                {
                    <option value="@s" selected="@(s == r.Status)">@s</option>
                }
            </select>
        </div>
        <div class="field-row stacked">
            <label for="reply" class="footnote">Reply the reporter sees@(language is null ? "" : $" (in {language})")</label>
            <textarea id="reply" name="reply" class="textarea" rows="3" maxlength="@Feedback.MaxReplyLength">@Model.Reply</textarea>
        </div>
        <div class="field-row">
            <label for="version">Fixed in</label>
            <input id="version" name="version" value="@(Model.FixedInVersion ?? Plate.Web.Features.Diagnostics.AppVersion.Current)" autocomplete="off" autocapitalize="off" spellcheck="false" />
        </div>
        <div class="row"><button type="submit" class="btn btn-plain" style="padding: 0">Save</button></div>
    </form>
    <p class="section-footer">A new reply shows with a badge in the reporter's Settings.</p>
</section>

<section class="section" id="whats-new">
    <h2 class="section-title">Add to What's new</h2>
    <form method="post" asp-antiforgery="true" action="/admin/changelog" class="list">
        <input type="hidden" name="feedbackId" value="@r.Id" />
        <input type="hidden" name="version" value="@(Model.FixedInVersion ?? Plate.Web.Features.Diagnostics.AppVersion.Current)" />
        <div class="field-row stacked">
            <label for="textEn" class="footnote">English</label>
            <textarea id="textEn" name="textEn" class="textarea" rows="2" maxlength="@ChangelogEntry.MaxTextLength" required></textarea>
        </div>
        <div class="field-row stacked">
            <label for="textBg" class="footnote">Bulgarian</label>
            <textarea id="textBg" name="textBg" class="textarea" rows="2" maxlength="@ChangelogEntry.MaxTextLength" required></textarea>
        </div>
        <div class="row"><button type="submit" class="btn btn-plain" style="padding: 0">Add</button></div>
    </form>
    <p class="section-footer">@(justFixed ? "Marked Fixed. If users can see the change, add a line." : "Every user sees it once on Today; the reporter sees \"You reported this\".")</p>
</section>

@if (Model.ParseRun is { } run)
{
    <section class="section">
        <h2 class="section-title">Parse run <a class="section-aside" href="/admin/parses/@run.Id">open</a></h2>
        <pre class="admin-pre">@FeedbackCommand.RunText(run, Model.ParseItemIndex)</pre>
    </section>
}

@if (Model.Error is { } error)
{
    <section class="section">
        <h2 class="section-title">Error</h2>
        <pre class="admin-pre">@FeedbackCommand.ErrorText(error)</pre>
    </section>
}

<section class="section">
    <details>
        <summary class="section-title">Context</summary>
        <pre class="admin-pre">@FeedbackCommand.ContextText(Model.Context)</pre>
    </details>
</section>
