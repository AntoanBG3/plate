@model Plate.Web.Features.Feedback.LabelScanDetail
@{
    var scan = Model.Scan;
    ViewData["Title"] = $"Label {scan.Id}";
    ViewData["BackUrl"] = "/admin/labels";
    ViewData["BackLabel"] = "Labels";
}
<header class="page-head">
    <h1 class="large-title">Label @scan.Id</h1>
    <p class="subhead">@scan.Reporter · @scan.CreatedAt.ToUniversalTime().ToString("d MMM yyyy HH:mm") UTC · @scan.Model · @scan.LatencyMs ms</p>
</header>
<section class="section">
    @if (scan.PhotoCount > 0)
    {
        @for (var n = 1; n <= scan.PhotoCount; n++)
        {
            <img src="/admin/labels/@scan.Id/photo/@n" alt="Label photo @n" style="width: 100%; border-radius: var(--r-md); margin-bottom: var(--s-3)" />
        }
    }
    else
    {
        <p class="footnote">Photos deleted after 30 days.</p>
    }
</section>
<section class="section">
    <pre class="admin-pre">@Plate.Web.Cli.FeedbackCommand.LabelText(Model)</pre>
</section>
