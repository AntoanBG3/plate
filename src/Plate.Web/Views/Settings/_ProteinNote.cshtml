@model ProteinNoteViewModel
@using Plate.Core.Nutrition
@inject TimeProvider Time
@{
    var year = Time.GetUtcNow().Year;
    var older = Model.Profile.BirthYear is { } born && year - born >= MacroTargets.OlderAdultAge;
}
@* Sent again out of band when the profile saves itself, so today's numbers follow the change. *@
<div id="protein-note" hx-swap-oob="@(Model.OutOfBand ? "true" : null)">
    <p class="section-footer">@L["Leave protein empty for Auto: 1.8 g per kg, 2.2 on a cut and 2.4 on a cut faster than 0.75% a week."]
        @if (Model.Targets?.Macros is { } m)
        {
            @L["Today: at least {0} g, aiming for {1} g.", m.ProteinMinG, m.ProteinAimG]
            if (Model.Targets.TrendWeightKg is { } trend && m.ReferenceKg < trend)
            {
                @(" " + L["Based on {0} kg, a healthy weight for your height.", m.ReferenceKg.Kg(1)])
            }
        }
    </p>
    @if (older && Model.Profile.ProteinGramsPerKg < 1.2m)
    {
        <p class="section-footer" style="color: var(--warning)">@L["From 65, under 1.2 g per kg is below what keeps muscle when you train."]</p>
    }
</div>
