@model ConfirmViewModel
@using Plate.Web.Features.Food
@{
    var date = Model.Date.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    ViewData["Title"] = L["Check foods"];
    ViewData["BackUrl"] = $"/food/add?date={date}&meal={Model.Meal}&tab=text";
    ViewData["BackLabel"] = L["Start over"];
}
<header class="page-head">
    <h1 class="large-title">@L["Check foods"]</h1>
    <p class="subhead">@L["Untick anything wrong and fix the grams. Nothing is saved until you tap Save."]</p>
</header>

<p class="bubble">@Model.Text</p>

@if (Model.Warning is not null)
{
    <div class="banner is-error" role="alert" style="margin-top: var(--s-4)">@Ui.Icon("alert")<span>@L[Model.Warning]</span></div>
}

<div data-module="food-review">
<form data-module="@(Model.ParseRunId is null ? null : "parse-rating")" data-run="@Model.ParseRunId" method="post" asp-antiforgery="true" action="/food/confirm" style="margin-top: var(--s-5)">
    <input type="hidden" name="requestId" value="@Model.RequestId" />
    @if (Model.ParseRunId is not null)
    {
        @* Shown by feedback.js: a rating is sent on its own, without saving the form. *@
        <div class="rate-row" data-rating hidden>
            <span class="footnote" data-rating-question>@L["Did this read your food right?"]</span>
            <button type="button" class="rate-btn" data-rate="Up" aria-pressed="false" aria-label="@L["Yes, it read it right"]">@Ui.Icon("thumb-up")</button>
            <button type="button" class="rate-btn" data-rate="Down" aria-pressed="false" aria-label="@L["No, something is wrong"]">@Ui.Icon("thumb-down")</button>
        </div>
    }
    <input type="hidden" name="date" value="@date" />
    <input type="hidden" name="meal" value="@Model.Meal" />
    <input type="hidden" name="aiModel" value="@Model.AiModel" />
    <input type="hidden" name="parseRunId" value="@Model.ParseRunId" />
    <div class="list">
        @for (var i = 0; i < Model.Items.Count; i++)
        {
            <partial name="_ReviewRow" model="new ReviewRowModel(Model.Items[i], i.ToString(System.Globalization.CultureInfo.InvariantCulture), i, Model.ParseRunId is not null, Millilitres: Model.UnitOf(Model.Items[i]) == Plate.Core.Domain.FoodUnit.Millilitres)" />
        }
    </div>
    <p class="section-footer">@L["Database values come from USDA or foods you saved. AI estimates are the model's own numbers; check them against the label if you can."]</p>
    <button type="submit" class="btn btn-primary btn-block" style="margin-top: var(--s-5)">@L[SaveTo[Model.Meal]]</button>
</form>
</div>

@section Overlays {
    <partial name="_ChangeFoodSheet" />
    @if (Model.ParseRunId is not null)
    {

        <div class="sheet" id="parse-sheet" hidden>
            <div class="sheet-scrim"></div>
            <div class="sheet-panel" role="dialog" aria-modal="true" aria-labelledby="parse-sheet-title">
                <div class="sheet-grabber" aria-hidden="true"></div>
                <div class="sheet-head"><span></span><span class="sheet-title" id="parse-sheet-title">@L["What was wrong?"]</span><button type="button" class="sheet-close" data-sheet-close>@L["Skip"]</button></div>
                <div class="sheet-stack">
                    <p class="footnote" data-sheet-item hidden></p>
                    <div class="choice-chips" role="group" aria-labelledby="parse-sheet-title">
                        @foreach (var (reason, text) in Plate.Web.Features.Feedback.FeedbackText.Reasons)
                        {
                            <label class="plate-choice"><input type="checkbox" name="reasons" value="@reason" /><span>@L[text]</span></label>
                        }
                    </div>
                    <label for="parse-sheet-message" class="sr-only">@L["Anything else?"]</label>
                    <textarea id="parse-sheet-message" class="textarea" name="message" rows="3" maxlength="2000" placeholder="@L["Anything else? What should it have been?"]"></textarea>
                    <button type="button" class="btn btn-primary btn-block" data-send-details>@L["Send"]</button>
                    <p class="footnote">@L["Your food is still not saved; you can fix it and save as usual."]</p>
                </div>
            </div>
        </div>
    }
}

@functions {
    private static readonly Dictionary<Meal, string> SaveTo = new()
    {
        [Meal.Breakfast] = "Save to breakfast",
        [Meal.Lunch] = "Save to lunch",
        [Meal.Dinner] = "Save to dinner",
        [Meal.Snack] = "Save as a snack",
    };
}
