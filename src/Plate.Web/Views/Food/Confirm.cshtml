@model ConfirmViewModel
@using Plate.Web.Features.Food
@{
    var date = Model.Date.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    ViewData["Title"] = L["Check foods"];
    ViewData["BackUrl"] = $"/food/add?date={date}&meal={Model.Meal}&tab=text";
    ViewData["BackLabel"] = L["Start over"];
}
<header class="page-head">
    <h1 class="large-title">@L["Check foods"]</h1>
    <p class="subhead">@L["Untick anything wrong and fix the grams. Nothing is saved until you tap Save."]</p>
</header>

<p class="bubble">@Model.Text</p>

@if (Model.Warning is not null)
{
    <div class="banner is-error" role="alert" style="margin-top: var(--s-4)">@Ui.Icon("alert")<span>@L[Model.Warning]</span></div>
}

<div data-module="food-review">
<form data-module="@(Model.ParseRunId is null ? null : "parse-rating")" data-run="@Model.ParseRunId" method="post" asp-antiforgery="true" action="/food/confirm" style="margin-top: var(--s-5)">
    <input type="hidden" name="requestId" value="@Model.RequestId" />
    @if (Model.ParseRunId is not null)
    {
        @* Shown by feedback.js: a rating is sent on its own, without saving the form. *@
        <div class="rate-row" data-rating hidden>
            <span class="footnote" data-rating-question>@L["Did this read your food right?"]</span>
            <button type="button" class="rate-btn" data-rate="Up" aria-pressed="false" aria-label="@L["Yes, it read it right"]">@Ui.Icon("thumb-up")</button>
            <button type="button" class="rate-btn" data-rate="Down" aria-pressed="false" aria-label="@L["No, something is wrong"]">@Ui.Icon("thumb-down")</button>
        </div>
    }
    <input type="hidden" name="date" value="@date" />
    <input type="hidden" name="meal" value="@Model.Meal" />
    <input type="hidden" name="aiModel" value="@Model.AiModel" />
    <input type="hidden" name="parseRunId" value="@Model.ParseRunId" />
    <div class="list">
        @for (var i = 0; i < Model.Items.Count; i++)
        {
            var item = Model.Items[i];
            var (chip, label) = item.Usual ? ("good", L["Your usual"]) : item.Confidence switch
            {
                Confidence.High => ("good", L["Database"]),
                Confidence.Medium => ("check", L["Check match"]),
                _ => ("ai", L["AI estimate"]),
            };
            var status = L.Status(item.Status, item.State);
            @* A counted amount ("две закуски") goes with the row, so its grams follow when another food is picked (site.js). *@
            <div class="result portion" data-row="@i" data-per100="@item.Per100.Kcal.Kg(),@item.Per100.Protein.Kg()" style="animation-delay: @(i * 70)ms"
                 data-amount-count="@item.Count?.Units.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-amount-of="@item.Count?.Of.ToString().ToLowerInvariant()" data-amount-grams="@(item.Count is null ? null : item.Grams.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                <div class="result-head">
                    <input type="checkbox" class="check-input" name="items[@i].Include" value="true" checked aria-label="@L["Include {0}", item.Description]" />
                    @* Grows to fit a long food name (field-sizing); Enter doesn't add a line (site.js). *@
                    <textarea class="input name-input" name="items[@i].Description" rows="1" maxlength="200" aria-label="@L["Description"]" data-one-line required>@item.Description</textarea>
                    <span class="chip status-chip" data-status @(status is null ? "hidden" : null)>@status</span>
                    <span class="chip @chip" data-chip>@label</span>
                    @if (Model.ParseRunId is not null)
                    {
                        <button type="button" class="rate-btn" data-rate="Down" data-item="@i" aria-pressed="false" aria-label="@L["{0} is wrong", item.Description]" hidden>@Ui.Icon("thumb-down")</button>
                    }
                </div>
                <div class="result-amount">
                    <label class="grams"><input type="text" name="items[@i].Grams" value="@item.Grams.Kg()" min="1" max="3000" step="any" inputmode="decimal" pattern="([0-9]+([.,][0-9]*)?|[.,][0-9]+)" autocomplete="off" aria-label="@L["Grams"]" required /><span class="footnote">@L["g"]</span></label>
                    <span class="footnote num" data-totals>@L["{0} kcal · {1} g protein", Math.Round(item.Per100.Kcal * item.Grams / 100), (item.Per100.Protein * item.Grams / 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)]</span>
                </div>
                @if (item.Choice is { } choice && item.FoodItemId is { } choiceId)
                {
                    @* A weighed staple without a state: the same food cooked and dry, one tap apart (site.js). *@
                    var inv = System.Globalization.CultureInfo.InvariantCulture;
                    var options = new[] { new Plate.Web.Features.Food.ChoiceFood(choiceId, item.MatchedName ?? item.Description, item.Per100, choice.Current), choice.Other }
                        .OrderBy(o => o.State == Plate.Core.Nutrition.FoodState.Cooked);
                    <div class="state-choice" data-state-choice>
                        <span class="footnote" id="state-q-@i">@L["When did you weigh it?"]</span>
                        <div class="segmented" role="group" aria-labelledby="state-q-@i">
                            @foreach (var o in options)
                            {
                                var on = o.State == choice.Current;
                                <button type="button" class="segment@(on ? " is-active" : "")" aria-pressed="@(on ? "true" : "false")" data-choice-food="@o.Id" data-state="@o.State.ToString().ToLowerInvariant()"
                                        data-name="@o.Name" data-status="@L.State(o.State)" data-kcal="@o.Per100.Kcal.ToString(inv)" data-protein="@o.Per100.Protein.ToString(inv)"
                                        data-carbs="@o.Per100.Carbs.ToString(inv)" data-fat="@o.Per100.Fat.ToString(inv)" data-fiber="@o.Per100.Fiber?.ToString(inv)" data-satfat="@o.Per100.SaturatedFat?.ToString(inv)">@(o.State == Plate.Core.Nutrition.FoodState.Raw ? L["Before cooking"] : L["After cooking"])</button>
                            }
                        </div>
                    </div>
                }
                <div class="result-notes footnote">
                    @* The full database name under the short one, so it's clear which food the numbers are. *@
                    <span data-using @(item.MatchedName is null ? "hidden" : null)>@(item.MatchedName is null ? "" : L["Database: {0}", item.MatchedName])</span>
                    @foreach (var note in item.Notes)
                    {
                        <span data-note>@L[note]</span>
                    }
                    <button type="button" class="btn btn-plain btn-small change-food" data-change-food="@i" data-query="@item.Typed">@L["Change food"]</button>
                </div>
                <details>
                    <summary>@L["Per 100 g values"]</summary>
                    <div class="per100">
                        <label>@L["kcal"]<input class="input num" type="text" name="items[@i].Kcal" value="@item.Per100.Kcal.Kg()" min="0" max="900" step="any" inputmode="decimal" pattern="([0-9]+([.,][0-9]*)?|[.,][0-9]+)" autocomplete="off" /></label>
                        <label>@L["Protein"]<input class="input num" type="text" name="items[@i].Protein" value="@item.Per100.Protein.Kg()" min="0" max="100" step="any" inputmode="decimal" pattern="([0-9]+([.,][0-9]*)?|[.,][0-9]+)" autocomplete="off" /></label>
                        <label>@L["Carbs"]<input class="input num" type="text" name="items[@i].Carbs" value="@item.Per100.Carbs.Kg()" min="0" max="100" step="any" inputmode="decimal" pattern="([0-9]+([.,][0-9]*)?|[.,][0-9]+)" autocomplete="off" /></label>
                        <label>@L["Fat"]<input class="input num" type="text" name="items[@i].Fat" value="@item.Per100.Fat.Kg()" min="0" max="100" step="any" inputmode="decimal" pattern="([0-9]+([.,][0-9]*)?|[.,][0-9]+)" autocomplete="off" /></label>
                        <label>@L["Fiber"]<input class="input num" type="text" name="items[@i].Fiber" value="@item.Per100.Fiber?.Kg()" min="0" max="100" step="any" inputmode="decimal" pattern="([0-9]+([.,][0-9]*)?|[.,][0-9]+)" autocomplete="off" /></label>
                        <label>@L["Saturated fat"]<input class="input num" type="text" name="items[@i].SaturatedFat" value="@item.Per100.SaturatedFat?.Kg()" min="0" max="100" step="any" inputmode="decimal" pattern="([0-9]+([.,][0-9]*)?|[.,][0-9]+)" autocomplete="off" /></label>
                    </div>
                </details>
                <input type="hidden" name="items[@i].FoodItemId" value="@item.FoodItemId" />
                <input type="hidden" name="items[@i].MatchModel" value="@item.MatchModel" />
                <input type="hidden" name="items[@i].Status" value="@status" />
            </div>
        }
    </div>
    <p class="section-footer">@L["Database values come from USDA or foods you saved. AI estimates are the model's own numbers; check them against the label if you can."]</p>
    <button type="submit" class="btn btn-primary btn-block" style="margin-top: var(--s-5)">@L[SaveTo[Model.Meal]]</button>
</form>
</div>

@section Overlays {
    @* Change food: search the database and put another food on a row (site.js). *@
    <div class="sheet" id="change-food-sheet" hidden>
        <div class="sheet-scrim"></div>
        <div class="sheet-panel" role="dialog" aria-modal="true" aria-labelledby="change-food-title">
            <div class="sheet-grabber" aria-hidden="true"></div>
            <div class="sheet-head"><span></span><span class="sheet-title" id="change-food-title">@L["Change food"]</span><button type="button" class="sheet-close" data-sheet-close>@L["Cancel"]</button></div>
            <div class="search-field">
                @Ui.Icon("search")
                <input type="search" class="input" name="q" aria-label="@L["Search foods"]" autocomplete="off" data-change-search
                       hx-get="/food/candidates" hx-trigger="input changed delay:300ms, search" hx-target="#change-food-results" hx-swap="innerHTML" />
            </div>
            <div id="change-food-results" class="change-food-results scroll-fade scroll-fade-y"></div>
        </div>
    </div>
    @if (Model.ParseRunId is not null)
    {

        <div class="sheet" id="parse-sheet" hidden>
            <div class="sheet-scrim"></div>
            <div class="sheet-panel" role="dialog" aria-modal="true" aria-labelledby="parse-sheet-title">
                <div class="sheet-grabber" aria-hidden="true"></div>
                <div class="sheet-head"><span></span><span class="sheet-title" id="parse-sheet-title">@L["What was wrong?"]</span><button type="button" class="sheet-close" data-sheet-close>@L["Skip"]</button></div>
                <div class="sheet-stack">
                    <p class="footnote" data-sheet-item hidden></p>
                    <div class="choice-chips" role="group" aria-labelledby="parse-sheet-title">
                        @foreach (var (reason, text) in Plate.Web.Features.Feedback.FeedbackText.Reasons)
                        {
                            <label class="plate-choice"><input type="checkbox" name="reasons" value="@reason" /><span>@L[text]</span></label>
                        }
                    </div>
                    <label for="parse-sheet-message" class="sr-only">@L["Anything else?"]</label>
                    <textarea id="parse-sheet-message" class="textarea" name="message" rows="3" maxlength="2000" placeholder="@L["Anything else? What should it have been?"]"></textarea>
                    <button type="button" class="btn btn-primary btn-block" data-send-details>@L["Send"]</button>
                    <p class="footnote">@L["Your food is still not saved; you can fix it and save as usual."]</p>
                </div>
            </div>
        </div>
    }
}

@functions {
    private static readonly Dictionary<Meal, string> SaveTo = new()
    {
        [Meal.Breakfast] = "Save to breakfast",
        [Meal.Lunch] = "Save to lunch",
        [Meal.Dinner] = "Save to dinner",
        [Meal.Snack] = "Save as a snack",
    };
}
