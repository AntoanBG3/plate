@model FoodAddViewModel
@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var date = Model.Date.ToString("yyyy-MM-dd", inv);
    var title = L[AddTo[Model.Meal]];
    ViewData["Title"] = title;
    ViewData["BackUrl"] = $"/food?date={date}";
    ViewData["BackLabel"] = L["Food"];
    // Also shown at /food/parse and /food/barcode when a read or a lookup fails.
    ViewData["Page"] = "food-add";
    string TabUrl(string tab) => $"/food/add?date={date}&meal={Model.Meal}&tab={tab}";
    string TabClass(string tab) => tab == Model.Tab ? "mode-tab is-active" : "mode-tab";
    string? Current(string tab) => tab == Model.Tab ? "page" : null;
}
<header class="page-head">
    <p class="eyebrow">@Ui.ShortDate(Model.Date)</p>
    <h1 class="large-title">@title</h1>
</header>

@* data-replace: choosing another mode is not a step to go back through; Back leaves the page. *@
<nav class="mode-tabs" data-replace aria-label="@L["How to add"]">
    @foreach (var (tab, label) in new[] { ("text", "Type"), ("barcode", "Scan"), ("search", "Search"), ("recent", "Recent"), ("manual", "Manual") })
    {
        <a class="@TabClass(tab)" href="@TabUrl(tab)" aria-current="@Current(tab)"><span>@L[label]@if (tab == Model.Tab) {<i class="mode-bar" aria-hidden="true"></i>}</span></a>
    }
</nav>

@if (Model.Error is not null && Model.Tab != "barcode")
{
    <div class="banner is-error" role="alert">@Ui.Icon("alert")<span>@L[Model.Error]</span></div>
}

@switch (Model.Tab)
{
    case "text":
        <form method="post" asp-antiforgery="true" action="/food/parse" data-busy>
            <input type="hidden" name="date" value="@date" />
            <input type="hidden" name="meal" value="@Model.Meal" />
            <div class="composer">
                <label for="text" class="sr-only">@L["What did you eat?"]</label>
                <textarea id="text" name="text" rows="1" maxlength="1000" placeholder="@L["What did you eat?"]" autofocus required>@Model.Text</textarea>
                <button type="submit" class="send-btn" aria-label="@L["Read it"]">@Ui.Icon("send")</button>
            </div>
            <p class="composer-hint footnote">@L["For example: 200 g chicken breast, 150 g cooked rice, a banana. English or Bulgarian. You check every item before anything is saved."]</p>
            <p class="thinking" role="status"><i></i><i></i><i></i><span>@L["Reading…"]</span></p>
        </form>
        @if (Model.Error is not null)
        {
            <a class="btn btn-secondary btn-block" style="margin-top: var(--s-5)" href="@TabUrl("manual")" data-replace>@L["Enter it by hand instead"]</a>
        }
        break;

    case "barcode":
        @* One label module holds the photo button and the slot the filled form opens in (SPEC 6.6). *@
        <div data-module="label">
        <div data-label-photos>
            <div class="btn-stack">
                <button type="button" class="btn btn-primary" data-start>@Ui.Icon("barcode")@L["Scan a barcode"]</button>
                @if (Model.LabelAvailable)
                {
                    <label class="btn btn-secondary" data-label-button data-label-single>@Ui.Icon("photo")@L["Photograph a label"]
                        <input type="file" accept="image/*" class="sr-only" data-label-photo data-label-start />
                    </label>
                }
            </div>
            @if (Model.LabelAvailable)
            {
                <partial name="_LabelPhotoSlots" model="true" />
            }
        </div>
        @if (Model.LabelAvailable)
        {
            @* For products without a barcode: the filled manual form opens here. *@
            <p class="section-footer" data-label-privacy>@L["The photo is sent to an AI model through OpenRouter and kept for 30 days so misreads can be checked."]</p>
            <p class="thinking" role="status" data-label-status><i></i><i></i><i></i><span>@L["Reading the label…"]</span></p>
            <div data-label-slot data-date="@date" data-meal="@Model.Meal" style="margin-top: var(--s-5)"></div>
        }
        </div>
        <form method="get" action="/food/barcode" id="barcode-form" class="section" style="margin-top: var(--s-6)">
            <input type="hidden" name="date" value="@date" />
            <input type="hidden" name="meal" value="@Model.Meal" />
            <h2 class="section-header">@L["Or type the digits"]</h2>
            <div class="list">
                <div class="field-row">
                    <label for="code" class="sr-only">@L["Barcode digits"]</label>
                    <input id="code" class="num" type="text" name="code" value="@Model.Text" inputmode="numeric" pattern="[0-9 \-]{8,16}" placeholder="@L["Digits under the barcode"]" required style="text-align: left; flex: 1; color: var(--label)" />
                    <button type="submit" class="btn btn-plain">@L["Look up"]</button>
                </div>
                @if (Model.Error is { } barcodeError)
                {
                    <p class="field-error" role="alert">@Ui.Icon("alert", "icon-sm")<span>@L[barcodeError]</span></p>
                }
            </div>
        </form>
        <p class="section-footer">@L["EAN-13, EAN-8, UPC-A or UPC-E: 8, 12 or 13 digits."] @L["The camera may ask for permission each time the app opens."]</p>
        break;

    case "search":
        <form method="get" action="/food/add">
            <input type="hidden" name="date" value="@date" />
            <input type="hidden" name="meal" value="@Model.Meal" />
            <input type="hidden" name="tab" value="search" />
            <div class="search-field">
                @Ui.Icon("search")
                <input type="search" class="input" name="q" value="@Model.Query" placeholder="@L["Oats, skyr, кашкавал…"]" aria-label="@L["Search foods"]" autofocus enterkeyhint="search" autocomplete="off"
                       hx-get="/food/add" hx-include="closest form" hx-trigger="input changed delay:300ms, search" hx-target="#search-results" hx-select="#search-results" hx-swap="outerHTML" hx-replace-url="true" />
            </div>
        </form>
        @* Results follow the field as it is typed in (htmx swaps this block); Enter still sends the form. *@
        <div id="search-results">
        @if (!string.IsNullOrWhiteSpace(Model.Query))
        {
            @foreach (var (heading, group) in new[] { (L["Your foods"], Model.Local.Where(f => f.Own).ToList()), (L["Food database"], Model.Local.Where(f => !f.Own).ToList()) }.Where(g => g.Item2.Count > 0))
            {
                <section class="section" style="margin-top: var(--s-5)">
                    <h2 class="section-header">@heading</h2>
                    <div class="list">
                        @foreach (var f in group)
                        {
                            <form asp-food-request="true" method="post" asp-antiforgery="true" action="/food/log-item" class="portion" data-per100="@f.KcalPer100g.Kg(),@f.ProteinPer100g.Kg()">
                                <input type="hidden" name="date" value="@date" />
                                <input type="hidden" name="meal" value="@Model.Meal" />
                                <input type="hidden" name="foodItemId" value="@f.Id" />
                                <input type="hidden" name="source" value="Search" />
                                <div class="row-title headline">@f.DisplayName</div>
                                <div class="row-sub">@(f.Brand is null ? "" : f.Brand + " · ")@L["{0} kcal, {1} g protein per 100 g", Math.Round(f.KcalPer100g), f.ProteinPer100g.Kg(1)]@(f.ByOther ? " · " + L["Added by another user"] : "")</div>
                                @{ var serving = Model.LastGrams is { } lastGrams && lastGrams.TryGetValue(f.Id, out var last) ? last : f.DefaultServingGrams ?? 100; }
                                <div class="portion-line">
                                    <label class="grams"><input type="text" name="grams" value="@serving.Kg()" min="1" max="3000" step="any" inputmode="decimal" pattern="[0-9]*[.,]?[0-9]*" autocomplete="off" aria-label="@L["Grams"]" required /><span class="footnote">@L["g"]</span></label>
                                    <span class="footnote num" data-totals>@L["{0} kcal · {1} g protein", Math.Round(f.KcalPer100g * serving / 100), (f.ProteinPer100g * serving / 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)]</span>
                                    <button type="submit" class="btn btn-tinted btn-small">@L["Add"]</button>
                                </div>
                            </form>
                        }
                    </div>
                </section>
            }
            @if (Model.OpenFoodFacts is null)
            {
                <div class="section" style="margin-top: var(--s-5)">
                    @if (Model.Local.Count == 0)
                    {
                        <p class="subhead" style="margin: 0 var(--s-4) var(--s-3)">@L["Nothing saved matches."]</p>
                    }
                    <a class="btn btn-secondary btn-block" href="/food/add?date=@date&amp;meal=@Model.Meal&amp;tab=search&amp;q=@Uri.EscapeDataString(Model.Query)&amp;off=true">@Ui.Icon("search")@L["Search Open Food Facts"]</a>
                </div>
            }
            else if (Model.OpenFoodFacts.Status == Plate.Core.Nutrition.LookupStatus.RateLimited)
            {
                <div class="banner is-error" style="margin-top: var(--s-5)">@Ui.Icon("clock")<span>@L["Open Food Facts is limiting requests right now. Try again in a minute."]</span></div>
            }
            else if (Model.OpenFoodFacts.Status != Plate.Core.Nutrition.LookupStatus.Found)
            {
                <div class="banner is-error" style="margin-top: var(--s-5)">@Ui.Icon("alert")<span>@L["Open Food Facts didn't answer. Try again later, or add the food by hand."]</span></div>
            }
            else
            {
                <section class="section" style="margin-top: var(--s-5)">
                    <h2 class="section-header">Open Food Facts</h2>
                    @{ var products = Model.OpenFoodFacts.Products.Where(p => Plate.Core.Nutrition.Barcodes.IsValid(p.Barcode)).ToList(); }
                    @if (products.Count == 0)
                    {
                        <p class="subhead" style="margin: 0 var(--s-4)">@L["No products with nutrition data found."]</p>
                    }
                    else
                    {
                        <div class="list">
                            @foreach (var p in products)
                            {
                                <a class="row row-link" href="/food/barcode?date=@date&amp;meal=@Model.Meal&amp;code=@p.Barcode">
                                    <span class="row-main">
                                        <span class="row-title" style="display: block">@p.Name</span>
                                        <span class="row-sub" style="display: block">@(p.Brand is null ? "" : p.Brand + " · ")@L["{0} kcal per 100 g", Math.Round(p.Per100.Kcal)]</span>
                                    </span>
                                    @Ui.Icon("chevron", "row-chevron")
                                </a>
                            }
                        </div>
                    }
                </section>
            }
        }
        </div>
        break;

    case "recent":
        @if (Model.SavedMeals.Count > 0)
        {
            <section class="section" style="margin-top: 0">
                <h2 class="section-header">@L["Saved meals"]</h2>
                <div class="list">
                    @foreach (var m in Model.SavedMeals)
                    {
                        <button type="button" class="row row-link" style="width: 100%; text-align: left" hx-get="/food/saved-meals/@m.Id?date=@date&amp;meal=@Model.Meal" hx-target="#food-sheet-body" hx-swap="innerHTML" data-sheet-open="food-sheet">
                            <span class="row-main">
                                <span class="row-title" style="display: block">@m.Name</span>
                                <span class="row-sub num" style="display: block">@L.Count(m.Items.Count, "1 item", "{0} items") · @L["{0} kcal", Math.Round(m.Items.Sum(i => i.Kcal))]</span>
                            </span>
                            @Ui.Icon("chevron", "row-chevron")
                        </button>
                    }
                </div>
            </section>
            <h2 class="section-header" style="margin-top: var(--s-6)">@L["Recent"]</h2>
        }
        @if (Model.Recents.Count == 0)
        {
            <div class="card empty">
                <div class="empty-icon">@Ui.Icon("history")</div>
                <h2>@L["Nothing recent yet"]</h2>
                <p>@L["Foods you log in the next 30 days show up here for one-tap logging."]</p>
            </div>
        }
        else
        {
            <div class="list">
                @foreach (var r in Model.Recents)
                {
                    <form asp-food-request="true" method="post" asp-antiforgery="true" action="/food/log-recent" class="portion" data-per100="@r.Per100.Kcal.Kg(),@r.Per100.Protein.Kg()">
                        <input type="hidden" name="date" value="@date" />
                        <input type="hidden" name="meal" value="@Model.Meal" />
                        <input type="hidden" name="description" value="@r.Description" />
                        <input type="hidden" name="foodItemId" value="@r.FoodItemId" />
                        <input type="hidden" name="kcal" value="@r.Per100.Kcal.Kg()" />
                        <input type="hidden" name="protein" value="@r.Per100.Protein.Kg()" />
                        <input type="hidden" name="carbs" value="@r.Per100.Carbs.Kg()" />
                        <input type="hidden" name="fat" value="@r.Per100.Fat.Kg()" />
                        <input type="hidden" name="fiber" value="@r.Per100.Fiber?.Kg()" />
                        <input type="hidden" name="saturatedFat" value="@r.Per100.SaturatedFat?.Kg()" />
                        <div class="row-title headline">@L.Entry(r.Description)</div>
                        <div class="portion-line">
                            <label class="grams"><input type="text" name="grams" value="@r.LastGrams.Kg()" min="1" max="3000" step="any" inputmode="decimal" pattern="[0-9]*[.,]?[0-9]*" autocomplete="off" aria-label="@L["Grams"]" required /><span class="footnote">@L["g"]</span></label>
                            <span class="footnote" data-totals>@L.Count(r.Times, "logged once in 30 days", "logged {0}× in 30 days")</span>
                            <button type="submit" class="btn btn-tinted btn-small">@L["Add"]</button>
                        </div>
                    </form>
                }
            </div>
        }
        break;

    default:
        <div data-module="label">
            <partial name="_ManualFoodForm" model="new ManualFoodFormModel(Model.Date, Model.Meal, null, Model.Text, BarcodeField: true, LabelAvailable: Model.LabelAvailable)" />
        </div>
        break;
}

@section Overlays {
    <div class="sheet" id="food-sheet" hidden>
        <div class="sheet-scrim"></div>
        <div class="sheet-panel" role="dialog" aria-modal="true" aria-labelledby="food-sheet-title">
            <div class="sheet-grabber" aria-hidden="true"></div>
            <div id="food-sheet-body"></div>
        </div>
    </div>
    @if (Model.Tab is "barcode" or "manual")
    {
        <partial name="_ScannerSheet" />
        @* Also reads a barcode out of a label photo (label.js), so it loads before label.js. *@
        <script src="~/lib/barcode-detector/barcode-detector-3.2.2.ponyfill.js" asp-append-version="true"></script>
        <script src="~/js/scanner.js" asp-append-version="true"></script>
    }
    @if (Model.LabelAvailable)
    {
        <script src="~/js/label.js" asp-append-version="true"></script>
    }
}

@functions {
    private static readonly Dictionary<Meal, string> AddTo = new()
    {
        [Meal.Breakfast] = "Add to breakfast",
        [Meal.Lunch] = "Add to lunch",
        [Meal.Dinner] = "Add to dinner",
        [Meal.Snack] = "Add a snack",
    };
}
