@model ManualFoodFormModel
@using Plate.Core.Nutrition
@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var date = Model.Date.ToString("yyyy-MM-dd", inv);
    var hasBarcode = Model.Barcode is not null || !string.IsNullOrEmpty(Model.BarcodeValue);
    // "No, it's different" on a shared food, carried through a label read or an error: the food stays private (SPEC 7).
    var declined = Model.BarcodeField && Plate.Web.Features.Food.ManualFoodService.Declined(Model.BarcodeValue, Model.DeclinedBarcode);
    var label = Model.Label;
    // Values the label filled in rather than the user, so a read with more photos may replace them (label.js). Razor
    // writes a data- attribute even for false or null, hence the explicit value.
    var nameFromLabel = Model.Name is null && label?.Name is not null;
    var gramsFromLabel = Model.TypedGrams is null && label?.ServingGrams is not null;
    // Numbers are written with a dot in both languages (SPEC 8), or the inputs' pattern rejects them on iOS.
    string? Value(string field, decimal? v) => Model.Submitted
        ? ViewData.ModelState[field]?.AttemptedValue : v?.ToString("0.#", inv);
    // A value computed from kJ or a per-serving column is marked for checking; one the label didn't give is left empty and marked.
    string Mark(decimal? v, LabelField field) =>
        label is null ? "num" : label.Converted.HasFlag(field) ? "num is-converted" : v is null ? "num is-missing" : "num";
    // Per 100 g or per 100 ml: the label's column, else what was sent back with an error, else grams (SPEC 6.6).
    var unit = label?.Unit ?? Model.Unit ?? Plate.Core.Domain.FoodUnit.Grams;
}
<div id="manual-food" data-label-form>
    @if (Model.LabelAvailable)
    {
        <div class="label-pick" data-label data-label-photos>
            <label class="btn btn-secondary btn-block" data-label-button data-label-single>@Ui.Icon("photo")@L["Read the label from a photo"]
                <input type="file" accept="image/*" class="sr-only" data-label-photo />
            </label>
            @if (label is not null)
            {
                <partial name="_LabelPhotoSlots" />
            }
            <p class="section-footer">@L["The photo is sent to an AI model through OpenRouter and kept for 30 days so misreads can be checked."]</p>
            <p class="thinking" role="status"><i></i><i></i><i></i><span>@L["Reading the label…"]</span></p>
        </div>
    }
    @if (label is not null)
    {
        <div class="banner" role="status">@Ui.Icon("check")<span>@L["Read from the photo. Check each value against the label."]
            @foreach (var note in label.Notes.Concat(label.Warnings))
            {
                <br />@L[note]
            }
        </span></div>
    }
    <form asp-food-request="true" method="post" asp-antiforgery="true" action="/food/items">
        <input type="hidden" name="date" value="@date" />
        <input type="hidden" name="barcodeField" value="@Model.BarcodeField.ToString()" />
        <input type="hidden" name="meal" value="@Model.Meal" />
        @if (Model.Barcode is not null)
        {
            <input type="hidden" name="barcode" value="@Model.Barcode" />
        }
        @if (Model.LabelScanId is { } scanId)
        {
            <input type="hidden" name="labelScanId" value="@scanId" />
        }
        <div class="list">
            <div class="field-row stacked"><label for="m-name" class="sr-only">@L["Name"]</label><input id="m-name" aria-invalid="@(Model.InvalidField == "name" ? "true" : null)" autofocus="@(Model.InvalidField == "name")" type="text" name="name" value="@(Model.Name ?? label?.Name)" data-from-label="@(nameFromLabel ? "true" : "false")" maxlength="200" required placeholder="@L["Food name, e.g. Кисело мляко 2%"]" /></div>
            @if (Model.BarcodeField)
            {
                <div class="field-row"><label for="m-barcode">@L["Barcode"]</label><input id="m-barcode" class="num" type="text" name="barcode" value="@Model.BarcodeValue" inputmode="numeric" pattern="[0-9 \-]{8,16}" autocomplete="off" placeholder="@L["Optional"]" data-barcode-input /><button type="button" class="icon-btn" data-scan-into aria-label="@L["Scan the barcode"]">@Ui.Icon("barcode")</button></div>
            }
        </div>
        @if (Model.BarcodeField)
        {
            <div data-known hidden="@(!declined)">
                @if (declined)
                {
                    <p class="section-footer" data-known-declined>@L["Another food already shares this barcode, so this one is kept for you only."]<input type="hidden" name="declinedBarcode" value="@(new string(Model.BarcodeValue!.Where(char.IsAsciiDigit).ToArray()))" /></p>
                }
            </div>
        }
        <h2 class="section-header" style="margin-top: var(--s-5)">@L["From the label"]</h2>
        <div class="segmented-wrap">
            <div class="segmented" role="radiogroup" aria-label="@L["Values per"]">
                <label class="segment"><input type="radio" name="unit" value="Grams" checked="@(unit == Plate.Core.Domain.FoodUnit.Grams)" />@L["Per 100 g"]</label>
                <label class="segment"><input type="radio" name="unit" value="Millilitres" checked="@(unit == Plate.Core.Domain.FoodUnit.Millilitres)" />@L["Per 100 ml"]</label>
            </div>
        </div>
        <div class="list">
            <div class="field-row"><label for="m-kcal">@L["Energy"]</label><input id="m-kcal" class="@Mark(label?.Kcal, LabelField.Kcal)" type="text" name="kcal" aria-invalid="@(Model.InvalidField == "kcal" ? "true" : null)" autofocus="@(Model.InvalidField == "kcal")" value="@Value("kcal", label?.Kcal)" min="0" max="900" step="any" inputmode="decimal" pattern="([0-9]+([.,][0-9]*)?|[.,][0-9]+)" autocomplete="off" required /><span class="unit">@L["kcal"]</span></div>
            <div class="field-row"><label for="m-protein">@L["Protein"]</label><input id="m-protein" class="@Mark(label?.Protein, LabelField.Protein)" type="text" name="protein" aria-invalid="@(Model.InvalidField == "protein" ? "true" : null)" autofocus="@(Model.InvalidField == "protein")" value="@Value("protein", label?.Protein)" min="0" max="100" step="any" inputmode="decimal" pattern="([0-9]+([.,][0-9]*)?|[.,][0-9]+)" autocomplete="off" required /><span class="unit">@L["g"]</span></div>
            <div class="field-row"><label for="m-carbs">@L["Carbs"]</label><input id="m-carbs" class="@Mark(label?.Carbs, LabelField.Carbs)" type="text" name="carbs" aria-invalid="@(Model.InvalidField == "carbs" ? "true" : null)" autofocus="@(Model.InvalidField == "carbs")" value="@Value("carbs", label?.Carbs)" min="0" max="100" step="any" inputmode="decimal" pattern="([0-9]+([.,][0-9]*)?|[.,][0-9]+)" autocomplete="off" required /><span class="unit">@L["g"]</span></div>
            <div class="field-row"><label for="m-fat">@L["Fat"]</label><input id="m-fat" class="@Mark(label?.Fat, LabelField.Fat)" type="text" name="fat" aria-invalid="@(Model.InvalidField == "fat" ? "true" : null)" autofocus="@(Model.InvalidField == "fat")" value="@Value("fat", label?.Fat)" min="0" max="100" step="any" inputmode="decimal" pattern="([0-9]+([.,][0-9]*)?|[.,][0-9]+)" autocomplete="off" required /><span class="unit">@L["g"]</span></div>
            <div class="field-row is-optional"><label for="m-satfat">@L["of which saturated"]</label><input id="m-satfat" class="@Mark(label?.SaturatedFat, LabelField.SaturatedFat)" type="text" name="saturatedFat" aria-invalid="@(Model.InvalidField == "saturatedFat" ? "true" : null)" autofocus="@(Model.InvalidField == "saturatedFat")" value="@Value("saturatedFat", label?.SaturatedFat)" min="0" max="100" step="any" inputmode="decimal" pattern="([0-9]+([.,][0-9]*)?|[.,][0-9]+)" autocomplete="off" placeholder="@L["Optional"]" /><span class="unit">@L["g"]</span></div>
            <div class="field-row is-optional"><label for="m-fiber">@L["Fiber"]</label><input id="m-fiber" class="@Mark(label?.Fiber, LabelField.Fiber)" type="text" name="fiber" aria-invalid="@(Model.InvalidField == "fiber" ? "true" : null)" autofocus="@(Model.InvalidField == "fiber")" value="@Value("fiber", label?.Fiber)" min="0" max="100" step="any" inputmode="decimal" pattern="([0-9]+([.,][0-9]*)?|[.,][0-9]+)" autocomplete="off" placeholder="@L["Optional"]" /><span class="unit">@L["g"]</span></div>
        </div>
        <h2 class="section-header" style="margin-top: var(--s-5)">@L["Portion"]</h2>
        <div class="list">
            <div class="field-row is-optional"><label for="m-serving">@L["One serving"]</label><input id="m-serving" class="num" type="text" name="servingGrams" aria-invalid="@(Model.InvalidField == "servingGrams" ? "true" : null)" autofocus="@(Model.InvalidField == "servingGrams")" value="@Value("servingGrams", label?.ServingGrams ?? Model.TypedServing)" min="1" max="3000" step="any" inputmode="decimal" pattern="([0-9]+([.,][0-9]*)?|[.,][0-9]+)" autocomplete="off" placeholder="@L["Optional"]" />@Ui.UnitWords(L)</div>
            <div class="field-row"><label for="m-grams">@L["You ate"]</label><input id="m-grams" class="num" type="text" name="grams" aria-invalid="@(Model.InvalidField == "grams" ? "true" : null)" autofocus="@(Model.InvalidField == "grams")" value="@Value("grams", Model.TypedGrams ?? label?.ServingGrams)" data-from-label="@(gramsFromLabel ? "true" : "false")" min="1" max="3000" step="any" inputmode="decimal" pattern="([0-9]+([.,][0-9]*)?|[.,][0-9]+)" autocomplete="off" required />@Ui.UnitWords(L)</div>
        </div>
        @* Shown only with a barcode: others find a shared food by scanning it (SPEC 4). Without one the server keeps it private. *@
        <div class="list" data-share style="margin-top: var(--s-5)" hidden="@(!hasBarcode || declined)">
            <label class="field-row switch-row">
                <span>@L["Share with other users"]</span>
                <input type="checkbox" class="switch" name="share" value="true" checked="@(Model.Share && !declined)" />
                <input type="hidden" name="share" value="false" />
            </label>
        </div>
        <p class="section-footer" data-share hidden="@(!hasBarcode || declined)">@L["Others who scan this barcode get this food instead of entering it again. Your name isn't shown."]</p>
        <button type="submit" class="btn btn-primary btn-block" style="margin-top: var(--s-5)">@L["Save and add"]</button>
    </form>
</div>
