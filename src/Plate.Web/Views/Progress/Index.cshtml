@model ProgressViewModel
@using System.Text.Json
@{
    ViewData["Title"] = L["Progress"];
    var points = Model.Weight.Points;
    var weighIns = points.Count(p => p.RawKg is not null);
    var weight = JsonSerializer.Serialize(new
    {
        labels = points.Select(p => Ui.DayMonth(p.Date)),
        raw = points.Select(p => p.RawKg),
        trend = points.Select(p => decimal.Round(p.TrendKg, 2)),
    });
    var e1rm = JsonSerializer.Serialize(new
    {
        labels = Model.E1rm.Select(p => Ui.DayMonth(p.Date)),
        values = Model.E1rm.Select(p => p.E1rmKg),
    });
    var calorieDays = Model.Calories;
    var calories = JsonSerializer.Serialize(new
    {
        labels = calorieDays.Select(d => Ui.DayMonth(d.Date)),
        kcal = calorieDays.Select(d => d.Kcal),
        target = calorieDays.Select(d => d.TargetKcal),
        maintenance = calorieDays.Select(d => d.MaintenanceKcal),
    });
    var proteinMin = Model.ProteinMinG;
    var protein = JsonSerializer.Serialize(new
    {
        labels = calorieDays.Select(d => Ui.DayMonth(d.Date)),
        eaten = calorieDays.Select(d => d.ProteinG),
        aim = calorieDays.Select(d => d.TargetProteinG),
        // Only on days that had a target: before the profile existed there was no minimum to draw.
        minimum = calorieDays.Select(d => d.TargetProteinG is null ? null : proteinMin),
    });
    var trained = Model.Volume.Muscles.Where(m => m.ThisWeek > 0 || m.LastWeek > 0).ToList();
    var volume = JsonSerializer.Serialize(new
    {
        labels = trained.Select(m => L.Enum(m.Muscle)),
        thisWeek = trained.Select(m => m.ThisWeek),
        lastWeek = trained.Select(m => m.LastWeek),
    });
    var loggedDays = calorieDays.Where(d => d.Kcal is not null).ToList();
}
<header class="page-head">
    <h1 class="large-title">@L["Progress"]</h1>
</header>

<section class="section">
    <h2 class="section-title">@L["Bodyweight"]</h2>
    <nav class="segmented" data-thumb aria-label="@L["Range"]" style="margin-bottom: var(--s-3)">
        @foreach (var (key, label) in Plate.Web.Features.Body.BodyAnalytics.Ranges)
        {
            <a class="segment@(key == Model.Weight.Range ? " is-active" : "")" aria-current="@(key == Model.Weight.Range ? "page" : null)" href="/progress?range=@key@(Model.Selected is null ? "" : $"&exerciseId={Model.Selected.Id}")">@L[label]</a>
        }
    </nav>
    <div class="card chart-card">
        @if (points.Count == 0)
        {
            <div class="empty" style="padding: var(--s-5) 0">
                <div class="empty-icon">@Ui.Icon("scale")</div>
                <h2>@L["No weigh-ins yet"]</h2>
                <p>@L["Log your weight on the Today page; the trend appears after a few days."]</p>
            </div>
        }
        else
        {
            <div class="chart-head">
                <div>
                    @* The trend is the big number; under it, how much it moved over the range shown (it used to repeat it). *@
                    <div class="chart-value num">@points[^1].TrendKg.Kg(1)<small> @L["kg"]</small></div>
                    @{ var change = points[^1].TrendKg - points[0].TrendKg; }
                    <div class="footnote num" data-trend-change>@(points.Count < 2
                        ? L["Trend weight"]
                        : L["{0} kg over this range", (change > 0 ? "+" : change < 0 ? "−" : "±") + Math.Abs(change).Kg(1)])</div>
                </div>
            </div>
            @if (weighIns < 3)
            {
                <p class="chart-sparse subhead">@L["The trend line appears after a few more weigh-ins."]</p>
            }
            else
            {
                <div class="chart"><canvas id="weight-chart" role="img" aria-label="@L["Weigh-ins and trend weight"]"></canvas></div>
                <div class="legend"><span><i style="background: var(--label-3); border-radius: 50%; width: 7px; height: 7px"></i>@L["Weigh-in"]</span><span><i class="line" style="background: var(--accent)"></i>@L["Trend"]</span></div>
            }
            <script type="application/json" id="weight-data">@Html.Raw(weight)</script>
        }
    </div>
</section>

<section class="section">
    <h2 class="section-title">@L["Estimated 1RM"]</h2>
    @if (Model.Selected is null)
    {
        <div class="card empty">
            <div class="empty-icon">@Ui.Icon("trend")</div>
            <h2>@L["No strength data yet"]</h2>
            <p>@L["Log a few workouts to see your strength trend."]</p>
        </div>
    }
    else
    {
        <form method="get" action="/progress" class="list" style="margin-bottom: var(--s-3)" data-autosubmit>
            <input type="hidden" name="range" value="@Model.Weight.Range" />
            <div class="field-row">
                <label for="exerciseId">@L["Exercise"]</label>
                <select id="exerciseId" name="exerciseId">
                    @foreach (var exercise in Model.Exercises)
                    {
                        <option value="@exercise.Id" selected="@(exercise.Id == Model.Selected.Id)">@L[exercise.Name]</option>
                    }
                </select>
            </div>
            <noscript><button type="submit" class="btn btn-plain">@L["Show"]</button></noscript>
        </form>
        <div class="card chart-card">
            @if (Model.E1rm.Count == 0)
            {
                <p class="chart-sparse subhead">@L["No sets of 1 to 12 reps logged for this exercise yet."]</p>
            }
            else
            {
                <div class="chart-head">
                    <div>
                        <div class="chart-value num">@Model.E1rm[^1].E1rmKg.Kg()<small>@L["kg"]</small></div>
                        <div class="footnote">@L["Latest, best set of the session (Epley)"]</div>
                    </div>
                    @if (Model.E1rm.Count > 1)
                    {
                        var change = Model.E1rm[^1].E1rmKg - Model.E1rm[0].E1rmKg;
                        <span class="chip @(change >= 0 ? "good" : "")">@((change >= 0 ? "+" : "−") + Math.Abs(change).Kg(1)) @L["kg"]</span>
                    }
                </div>
                @if (Model.E1rm.Count < 3)
                {
                    <p class="chart-sparse subhead">@L["The chart appears after a few more sessions."]</p>
                }
                else
                {
                    <div class="chart"><canvas id="e1rm-chart" role="img" aria-label="@L["Estimated one-rep max per session"]"></canvas></div>
                    <script type="application/json" id="e1rm-data">@Html.Raw(e1rm)</script>
                }
            }
        </div>
    }
</section>

<section class="section">
    <h2 class="section-title">@L["Weekly sets"]</h2>
    <div class="card chart-card">
        @if (trained.Count == 0)
        {
            <p class="chart-sparse subhead">@L["No working sets in the last two weeks."]</p>
        }
        else
        {
            <div class="chart-head"><div class="footnote">@L["Working sets per muscle, this week ({0}–{1}) against last week. Secondary muscles count as half a set.", Ui.DayMonth(Model.Volume.ThisWeek.Monday), Ui.DayMonth(Model.Volume.ThisWeek.Monday.AddDays(6))]</div></div>
            <div class="chart tall" style="height: @(Math.Max(160, trained.Count * 40))px"><canvas id="volume-chart" role="img" aria-label="@L["Working sets per muscle this week and last week"]"></canvas></div>
            <div class="legend"><span><i style="background: var(--accent)"></i>@L["This week"]</span><span><i style="background: var(--fill-strong)"></i>@L["Last week"]</span></div>
            <script type="application/json" id="volume-data">@Html.Raw(volume)</script>
        }
    </div>
</section>

<section class="section">
    <h2 class="section-title">@L["Calories"]</h2>
    <div class="card chart-card">
        @if (loggedDays.Count == 0)
        {
            <p class="chart-sparse subhead">@L["No food logged in the last 4 weeks."]</p>
        }
        else
        {
            <div class="chart-head">
                <div>
                    <div class="chart-value num">@Math.Round(loggedDays.Average(d => d.Kcal!.Value))<small>@L["kcal"]</small></div>
                    <div class="footnote">@L["Average on logged days, last 4 weeks"]</div>
                </div>
            </div>
            <div class="chart"><canvas id="calories-chart" role="img" aria-label="@L["Daily calories against target for the last 4 weeks"]"></canvas></div>
            <div class="legend"><span><i style="background: var(--fill-strong)"></i>@L["Eaten"]</span><span><i class="line" style="background: var(--accent)"></i>@L["Target"]</span><span><i class="dash"></i>@L["Maintenance"]</span></div>
            <script type="application/json" id="calories-data">@Html.Raw(calories)</script>
        }
    </div>
</section>

@if (loggedDays.Count > 0)
{
    <section class="section">
        <h2 class="section-title">@L["Protein"]</h2>
        <div class="card chart-card">
            <div class="chart-head">
                <div>
                    <div class="chart-value num">@Math.Round(loggedDays.Average(d => d.ProteinG ?? 0))<small>@L["g"]</small></div>
                    <div class="footnote">@L["Average on logged days, last 4 weeks"]</div>
                </div>
            </div>
            <div class="chart"><canvas id="protein-chart" role="img" aria-label="@L["Daily protein against the aim and minimum for the last 4 weeks"]"></canvas></div>
            <div class="legend"><span><i style="background: var(--fill-strong)"></i>@L["Eaten"]</span><span><i class="line" style="background: var(--label)"></i>@L["Aim"]</span>@if (proteinMin is not null)
                {
                    <span><i class="dash"></i>@L["Minimum"]</span>
                }</div>
            <script type="application/json" id="protein-data">@Html.Raw(protein)</script>
        </div>
    </section>
}

@if (Model.Week is { } week)
{
    <partial name="_WeekCard" model="week" />
}

<div data-module="progress" hidden></div>
<script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
<script src="~/js/progress.js" asp-append-version="true"></script>
