@model List<HistoryItem>
@inject UserTime Time
@{
    ViewData["Title"] = L["History"];
    ViewData["BackUrl"] = "/train";
    ViewData["BackLabel"] = L["Train"];
}
<header class="page-head">
    <h1 class="large-title">@L["History"]</h1>
</header>
@if (Model.Count == 0)
{
    <div class="card empty">
        <div class="empty-icon">@Ui.Icon("history")</div>
        <h2>@L["No workouts yet"]</h2>
        <p>@L["Finished workouts show up here, newest first."]</p>
        <a class="btn btn-tinted" href="/train">@L["Start a workout"]</a>
    </div>
}
else
{
    @foreach (var month in Model.GroupBy(i => (i.StartedAt.Year, i.StartedAt.Month)))
    {
        var first = await Time.LocalAsync(month.First().StartedAt);
        <section class="section">
            <h2 class="section-header">@(char.ToUpper(first.ToString("MMMM yyyy", Localizer.DateCulture)[0]) + first.ToString("MMMM yyyy", Localizer.DateCulture)[1..])</h2>
            <div class="list">
                @foreach (var item in month)
                {
                    var started = await Time.LocalAsync(item.StartedAt);
                    <a class="row row-link" href="/train/sessions/@item.Id">
                        <span class="row-main">
                            <span class="row-title headline" style="display: block">@(item.Name == "Freestyle" ? L["Freestyle"] : item.Name)</span>
                            <span class="row-sub" style="display: block">
                                @Ui.ShortDate(started.DateTime), @Ui.Time(started.DateTime) · @L.Count(item.WorkingSets, "1 set", "{0} sets") · @(item.EndedAt is { } end ? L.Duration(end - item.StartedAt) : L["in progress"])
                            </span>
                        </span>
                        @Ui.Icon("chevron", "row-chevron")
                    </a>
                }
            </div>
        </section>
    }
}
