@using Plate.Core.Nutrition
@model TodayViewModel
@inject UserTime Time
@inject TimeProvider Clock
@{
    var localNow = await Time.LocalAsync(Clock.GetUtcNow());
    ViewData["Title"] = L["Today"];
    var t = Model.Targets;
    var eaten = Model.Eaten;
    const string Arc = "M31.16 118.84 A62 62 0 1 1 118.84 118.84";
    // A notch across the gauge arc at a share of the way along it (the arc runs 270° clockwise from 135°).
    string Notch(decimal share)
    {
        var a = (135 + 270 * (double)Math.Clamp(share, 0m, 1m)) * Math.PI / 180;
        string P(double r) => $"{(75 + r * Math.Cos(a)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)} {(75 + r * Math.Sin(a)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}";
        return $"M{P(53)} L{P(71)}";
    }
    string Share(decimal value, int target) => (target > 0 ? Math.Min(1m, value / target) : 0m).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    var spark = Sparkline.From(Model.RecentWeights);
    var trendNow = t.TrendWeightKg;
    var weekAgo = Model.RecentWeights.Count > 7 ? Model.RecentWeights[^8].TrendKg : (decimal?)null;
    var weekDelta = trendNow is { } now && weekAgo is { } ago ? now - ago : (decimal?)null;
}
<header class="page-head">
    <p class="eyebrow">@Ui.LongDate(Model.Today)</p>
    <h1 class="large-title">@L["Today"]</h1>
</header>

@if (ViewData["WhatsNew"] is List<Plate.Web.Features.Feedback.WhatsNewItem> { Count: > 0 } news)
{
    <section class="card card-pad whats-new" id="whats-new" style="margin-bottom: var(--s-5)">
        <div class="feedback-head">
            <h2 class="section-title" style="margin: 0">@L["What's new"]</h2>
            <form method="post" asp-antiforgery="true" action="/today/whats-new/dismiss" hx-post="/today/whats-new/dismiss" hx-target="#whats-new" hx-swap="outerHTML">
                <button type="submit" class="btn btn-plain">@L["Got it"]</button>
            </form>
        </div>
        <ul>
            @foreach (var item in news)
            {
                <li>@item.Text@if (item.Yours)
                    {
                        <span class="chip good" style="margin-left: var(--s-2)">@L["You reported this"]</span>
                    }</li>
            }
        </ul>
    </section>
}

<a class="card tap" href="/food" aria-label="@L["Food today"]">
    @if (t.Kcal is { } kcal && t.ProteinG is { } protein)
    {
        var left = kcal - (int)Math.Round(eaten.Kcal);
        var eatenP = (int)Math.Round(eaten.ProteinG);
        var macros = t.Macros;
        // The ring counts toward the aim and marks the minimum (SPEC 7); the minimum is the caption under it.
        var leftP = protein - eatenP;
        var minReached = macros is not null && eatenP >= macros.ProteinMinG;
        <div class="gauges">
            <div class="gauge@(left < 0 ? " over" : "")">
                <svg viewBox="0 0 150 128" aria-hidden="true"><path class="track" d="@Arc"/><path class="bar-kcal" d="@Arc" data-progress="@Share(eaten.Kcal, kcal)"/></svg>
                <div class="gauge-center">
                    <div class="gauge-value num" data-count="@Math.Abs(left)">@Math.Abs(left)</div>
                    <div class="gauge-label">@(left >= 0 ? L["kcal left"] : L["kcal over"])</div>
                </div>
            </div>
            <div class="gauge">
                <svg viewBox="0 0 150 128" aria-hidden="true"><path class="track" d="@Arc"/><path class="bar-protein" d="@Arc" data-progress="@Share(eaten.ProteinG, protein)"/>@if (macros is not null && macros.ProteinMinG < protein)
                    {
                        <path class="notch" d="@Notch((decimal)macros.ProteinMinG / protein)"/>
                    }</svg>
                <div class="gauge-center">
                    <div class="gauge-value num"><span data-count="@Math.Max(0, leftP)">@Math.Max(0, leftP)</span><small> @L["g"]</small></div>
                    <div class="gauge-label">@L["protein left"]</div>
                    @if (macros is not null && macros.ProteinMinG < protein)
                    {
                        <div class="gauge-sub num@(minReached ? " reached" : "")" data-protein-min>@if (minReached)
                            {
                                @Ui.Icon("check", "icon-sm")
                            }@L["min {0} g", macros.ProteinMinG]</div>
                    }
                </div>
            </div>
        </div>
        @if (macros is not null)
        {
            <div class="mini-macros">
                <div>
                    <div class="footnote">@L["Fat"] <span class="num">@L["{0} g", Math.Round(eaten.FatG)]</span></div>
                    @Ui.Meter(eaten.FatG, macros.FatMaxG * 1.15m, L["{0} g fat, range {1} to {2} g", Math.Round(eaten.FatG), macros.FatMinG, macros.FatMaxG], notches: [macros.FatMinG, macros.FatMaxG])
                    <div class="caption num">@L["{0}–{1} g", macros.FatMinG, macros.FatMaxG]</div>
                </div>
                <div>
                    <div class="footnote">@L["Carbs"] <span class="num">@L["{0} g", Math.Round(eaten.CarbsG)]</span></div>
                    @Ui.Meter(eaten.CarbsG, Math.Max(1, macros.CarbsMaxG) * 1.15m, L["{0} g carbs, range {1} to {2} g", Math.Round(eaten.CarbsG), macros.CarbsMinG, macros.CarbsMaxG], notches: [macros.CarbsMinG, macros.CarbsMaxG])
                    <div class="caption num">@L["{0}–{1} g", macros.CarbsMinG, macros.CarbsMaxG]</div>
                </div>
                <div>
                    @{ var fiberG = Model.Quality.FiberG ?? 0; }
                    <div class="footnote">@L["Fiber"] <span class="num">@(Model.Quality.FiberComplete ? "" : "≥")@L["{0} g", Math.Round(fiberG)]</span></div>
                    @Ui.Meter(fiberG, macros.FiberMinG, L["{0} of {1} g fiber", Math.Round(fiberG), macros.FiberMinG])
                    <div class="caption num">@L["min {0} g", macros.FiberMinG]</div>
                </div>
            </div>
        }
        <p class="gauges-foot footnote">@(macros is not null && macros.ProteinMinG < protein
            ? L["Eaten {0} of {1} kcal and {2} of {3} g protein (minimum {4} g)", Math.Round(eaten.Kcal), kcal, eatenP, protein, macros.ProteinMinG]
            : L["Eaten {0} of {1} kcal and {2} of {3} g protein", Math.Round(eaten.Kcal), kcal, eatenP, protein])</p>
    }
    else
    {
        <div class="card-pad">
            <p class="headline">@L["{0} kcal eaten", Math.Round(eaten.Kcal)]</p>
            @if (t.Missing is not null)
            {
                <p class="subhead" style="margin-top: 4px">@L[t.Missing]</p>
            }
        </div>
    }
</a>

@if (Model.DietBreakUntil is { } breakUntil)
{
    <section class="card card-pad check-in">
        <p class="headline">@L["Diet break until {0}", Ui.ShortDate(breakUntil)]</p>
        <p class="subhead">@L["Calories are at maintenance; protein stays at your cut aim. The cut resumes on its own."]</p>
        <form method="post" asp-antiforgery="true" action="/today/cut/end-break">
            <button type="submit" class="btn btn-plain">@L["End the break now"]</button>
        </form>
    </section>
}
else if (Model.CutChecks.Count > 0)
{
    <section class="card card-pad check-in">
        @foreach (var check in Model.CutChecks)
        {
            <p class="subhead">@(check.Kind switch
            {
                CutCheckKind.TooFast => L["You're losing about {0}% of your weight a week, faster than planned. Fast cuts cost more muscle; your target will adjust, or lower the rate in Settings.", check.LossPercentPerWeek?.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)],
                CutCheckKind.ProteinLow => L["Protein averaged {0} g this week, under your minimum of {1} g.", check.ProteinG, check.ProteinMinG],
                _ => L["You've been cutting for 12 weeks. A 2-week break at maintenance can help you keep muscle and stick with it."],
            })</p>
        }
        <div class="check-in-actions">
            @if (Model.CutChecks.Any(c => c.Kind == CutCheckKind.BreakOffer))
            {
                <form method="post" asp-antiforgery="true" action="/today/cut/break">
                    <button type="submit" class="btn btn-tinted">@L["Take a 2-week break"]</button>
                </form>
            }
            <form method="post" asp-antiforgery="true" action="/today/cut/dismiss">
                <button type="submit" class="btn btn-plain">@L["Dismiss for a week"]</button>
            </form>
        </div>
    </section>
}

@if (Model.Weekly.Stored is { } weekly)
{
    <partial name="_WeeklySummary" model="weekly" />
}
else if (Model.Weekly.CanWrite)
{
    <section class="card card-pad weekly-summary loading" hx-get="/today/weekly-summary" hx-trigger="load" hx-swap="outerHTML" data-quiet-on-error aria-busy="true">
        <p class="footnote">@L["Last week"]</p>
        <p class="subhead">@L["Writing your summary of last week…"]</p>
    </section>
}

<section class="section">
    <h2 class="section-title">@L["Workout"]</h2>
    @if (Model.ActiveSession is { } active)
    {
        <div class="card card-pad">
            <p class="footnote">@L["In progress · {0}", L.Duration(Clock.GetUtcNow() - active.StartedAt)]</p>
            <p class="large-title" style="font-size: var(--text-title-1); margin: 4px 0 var(--s-4); view-transition-name: none">@(active.Template?.Name ?? L["Freestyle"])</p>
            <a class="btn btn-primary btn-block" href="/train/sessions/@active.Id">@Ui.Icon("play")@L["Resume workout"]</a>
        </div>
    }
    else if (Model.DoneToday is { Count: > 0 } done)
    {
        @* A workout finished today comes first; the next one is a smaller row under it (SPEC 7). *@
        <div class="list">
            @foreach (var d in done)
            {
                <a class="row row-link" href="/train/sessions/@d.Id/summary" data-done-today>
                    <span class="row-icon">@Ui.Icon("check")</span>
                    <span class="row-main">
                        <span class="row-title" style="display: block">@L["Done today: {0}", d.Name == "Freestyle" ? L["Freestyle"] : d.Name]</span>
                        <span class="row-sub num" style="display: block">@L.Duration((d.EndedAt ?? d.StartedAt) - d.StartedAt) · @L.Count(d.WorkingSets, "1 set", "{0} sets")</span>
                    </span>
                    @Ui.Icon("chevron", "row-chevron")
                </a>
            }
            @if (Model.NextTemplate is { } after)
            {
                <form method="post" asp-antiforgery="true" action="/train/start" class="row" data-up-next>
                    <input type="hidden" name="templateId" value="@after.Id" />
                    <span class="row-main">
                        <span class="footnote" style="display: block">@L["Up next"]</span>
                        <span class="row-title row-ellipsis" style="display: block">@after.Name</span>
                    </span>
                    <button type="submit" class="btn btn-tinted btn-small">@L["Start"]</button>
                </form>
            }
        </div>
    }
    else if (Model.NextTemplate is { } next)
    {
        <div class="card card-pad" data-up-next>
            <p class="footnote">@L["Up next"]</p>
            <p class="large-title" style="font-size: var(--text-title-1); margin: 4px 0 2px; view-transition-name: none">@next.Name</p>
            <p class="subhead row-ellipsis" style="margin-bottom: var(--s-4)">@string.Join(", ", next.Exercises.OrderBy(e => e.SortOrder).Select(e => L.Exercise(e.Exercise)))</p>
            <form method="post" asp-antiforgery="true" action="/train/start">
                <input type="hidden" name="templateId" value="@next.Id" />
                <button type="submit" class="btn btn-primary btn-block">@Ui.Icon("play")@L["Start {0}", next.Name]</button>
            </form>
        </div>
    }
    else
    {
        <div class="card empty">
            <div class="empty-icon">@Ui.Icon("train")</div>
            <h2>@L["No workouts yet"]</h2>
            <p>@L["Make a template with the exercises you do, and Today will suggest the next one."]</p>
            <a class="btn btn-tinted" href="/train/templates">@L["Create a template"]</a>
        </div>
    }
</section>

<section class="section">
    <h2 class="section-title">@L["Body"]</h2>
    <div class="list">
        @if (trendNow is { } trend)
        {
            <div class="row">
                <div class="row-main">
                    <div>@L["Trend weight"]</div>
                    <div class="metric-value num" style="font-size: var(--text-large-title); margin-top: 6px"><span data-count="@trend.Kg(1)">@trend.Kg(1)</span><span class="metric-unit">@L["kg"]</span></div>
                    @if (weekDelta is { } delta)
                    {
                        <div class="footnote" style="margin-top: 4px">@L["{0} kg this week", (delta >= 0 ? "+" : "−") + Math.Abs(delta).Kg(1)]</div>
                    }
                </div>
                @if (spark is not null)
                {
                    <svg class="spark" viewBox="0 0 128 52" aria-hidden="true">
                        <path class="spark-area" d="@spark.Area"/>
                        @foreach (var (x, y) in spark.Dots)
                        {
                            <circle class="spark-dot" cx="@x.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" cy="@y.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" r="2"/>
                        }
                        <path class="spark-line" d="@spark.Line" data-draw/>
                    </svg>
                }
            </div>
        }
        <form method="post" asp-antiforgery="true" action="/today/weight" class="field-row">
            <label for="weightKg">@L["Today's weight"]</label>
            <input id="weightKg" class="num" type="text" name="weightKg" inputmode="decimal" pattern="[0-9]*[.,]?[0-9]*" autocomplete="off" step="any" min="@ProfileLimits.MinWeightKg.Kg()" max="@ProfileLimits.MaxWeightKg.Kg()"
                   placeholder="—" required value="@(Model.TodayWeight?.WeightKg.Kg())" @(Model.TodayWeight is null ? "autofocus" : "") />
            <span class="unit">@L["kg"]</span>
            <button type="submit" class="btn btn-plain">@(Model.TodayWeight is null ? L["Save"] : L["Update"])</button>
        </form>
    </div>
    @if (Model.TodayWeight is not null)
    {
        <p class="section-footer">@L["Logged today: {0} kg", Model.TodayWeight.WeightKg.Kg()]</p>
    }
    else if (Model.LatestWeight is not null)
    {
        <p class="section-footer">@L["Last weigh-in: {0} kg on {1}", Model.LatestWeight.WeightKg.Kg(), Ui.DayMonth(Model.LatestWeight.Date)]</p>
    }
</section>

<section class="section">
    <div class="list">
        <a class="row row-link" href="/food/add?date=@Model.Today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)&amp;meal=@Ui.MealAt(localNow)">
            <span class="row-icon">@Ui.Icon("food")</span>
            <span class="row-main">
                <span class="row-title">@L["Log food"]</span>
                @if (Model.LastFood is not null)
                {
                    <span class="row-sub row-ellipsis" style="display: block">@L["Last: {0}", L.Entry(Model.LastFood)]</span>
                }
            </span>
            @Ui.Icon("chevron", "row-chevron")
        </a>
    </div>
</section>

@if (t.Estimate is { } estimate)
{
    <p class="section-footer" style="margin-top: var(--s-6)">
        @if (estimate.Method == MaintenanceMethod.Adaptive)
        {
            @L["Maintenance {0} kcal, adaptive from {1} days of data.", estimate.EstimatedTdeeKcal, estimate.DaysOfData]
            if (estimate.LowConfidence)
            {
                <span class="warn"> @L["Low confidence: weigh-ins had a gap of 3 or more days."]</span>
            }
        }
        else
        {
            @(estimate.DaysOfData > 0
                ? L["Maintenance {0} kcal, initial estimate ({1} days of data, food logged on {2}%).", estimate.EstimatedTdeeKcal, estimate.DaysOfData, (int)Math.Round(estimate.LoggingCompleteness * 100)]
                : L["Maintenance {0} kcal, initial estimate.", estimate.EstimatedTdeeKcal])
            @(" ")@L["It adapts weekly once you have 2 weeks of weigh-ins on most days and food logged on 80% of days."]
        }
        @if (t.FloorApplied)
        {
            <span class="warn"> @L["Raised to the {0} kcal minimum. Consider a slower rate in Settings.", t.FloorKcal]</span>
        }
    </p>
    <a class="btn btn-plain" style="margin-left: var(--s-2); font-size: var(--text-footnote)" href="/feedback/new?about=Maintenance&id=@estimate.Id">@L["Seems off?"]</a>
}
