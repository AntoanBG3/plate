@model ModelPickerViewModel
@using Plate.Web.Integrations
@{
    var title = AiTasks.Title(Model.Task);
    ViewData["Title"] = title;
    ViewData["BackUrl"] = "/admin/ai";
    ViewData["BackLabel"] = "AI";
}
<header class="page-head">
    <h1 class="large-title">@title</h1>
</header>

@if (Model.Models is null)
{
    <p class="empty">@L["OpenRouter's model list can't be loaded right now. Try again later."]</p>
}
else
{
    @if (AiTasks.HasEffort(Model.Task) && Model.Current != AiTasks.Off)
    {
        <section class="section" id="effort">
            <h2 class="section-title">Reasoning effort</h2>
            @if (Model.CurrentInfo is { Efforts.Count: > 0 } info)
            {
                var sent = info.EffortFor(Model.Effort);
                <div class="list">
                    @foreach (var effort in new[] { AiTasks.LowestEffort }.Concat(info.Efforts))
                    {
                        var picked = effort == AiTasks.LowestEffort ? Model.Effort is null : Model.Effort == effort;
                        <form method="post" asp-antiforgery="true" action="/admin/ai/effort/@AiTasks.Slug(Model.Task)" class="row row-link">
                            <input type="hidden" name="effort" value="@effort" />
                            <button type="submit" class="row-main" style="text-align: left; display: flex; justify-content: space-between; gap: var(--s-3); align-items: center; min-height: 22px" aria-current="@(picked ? "true" : null)">
                                <span class="row-title">@(effort == AiTasks.LowestEffort ? $"Lowest ({info.LowestEffort}), the default" : effort)</span>
                                @if (picked)
                                {
                                    <span style="color: var(--accent); flex: none">@Ui.Icon("check")</span>
                                }
                            </button>
                        </form>
                    }
                </div>
                <p class="section-footer">Sent as reasoning.effort with every call for this task@(Model.Task == AiTask.Parser ? ", and for the short food names on Check foods, which use the parser's model" : ""). Now sending: @sent. A higher effort reasons more, which costs output tokens and time; for some models no reasoning is priced above a little. Saving runs the task's check with the new effort.@(Model.Effort is { } kept && !info.Efforts.Contains(kept) ? $" The effort picked before ({kept}) isn't one this model takes, so its lowest is sent." : "")</p>
            }
            else
            {
                <p class="section-footer">@(Model.CurrentInfo is null ? "The model list can't be loaded, so the efforts aren't known; the model's lowest is sent." : "This model has no effort setting.")</p>
            }
        </section>
    }

    <div class="search-field">
        @Ui.Icon("search")
        <input type="search" class="input" placeholder="@L["Search models"]" aria-label="@L["Search models"]" data-filter="#model-groups" autocomplete="off" />
    </div>

    <div id="model-groups">
        @foreach (var group in Model.Models.GroupBy(m => m.Provider).OrderByDescending(g => g.Any(m => m.Id == Model.Current)))
        {
            <section class="section" data-filter-group style="margin-top: var(--s-5)">
                <h2 class="section-header">@group.Key</h2>
                <div class="list">
                    @foreach (var m in group)
                    {
                        var current = m.Id == Model.Current;
                        <form method="post" asp-antiforgery="true" action="/admin/ai/model/@AiTasks.Slug(Model.Task)" class="row row-link" data-filter-item="@group.Key @m.Name @m.Id">
                            <input type="hidden" name="modelId" value="@m.Id" />
                            <button type="submit" class="row-main" style="text-align: left; display: flex; justify-content: space-between; gap: var(--s-3); align-items: center; min-height: 22px" aria-current="@(current ? "true" : null)">
                                <span style="min-width: 0">
                                    <span class="row-title" style="display: block">@(m.Id == AiTasks.Off ? AiTasks.OffLabel(Model.Task) : m.Name)</span>
                                    <span class="row-sub" style="display: block">@L[m.Price]</span>
                                    @if (Model.Accuracy?.GetValueOrDefault(m.Id) is { } stats)
                                    {
                                        <span class="row-sub" style="display: block">@(stats.Enough && Model.Task == AiTask.Label
                                            ? L["Last 90 days: {0} reads, {1}% of saved ones edited, {2}% failed", stats.Runs, Percent(stats.CorrectionRate ?? 0), Percent(stats.DownRate)]
                                            : stats.Enough
                                            ? (stats.CorrectionRate is { } corrected
                                                ? L["Last 90 days: {0} entries, {1}% corrected before saving, {2}% rated wrong", stats.Runs, Percent(corrected), Percent(stats.DownRate)]
                                                : L["Last 90 days: {0} entries, {1}% rated wrong", stats.Runs, Percent(stats.DownRate)])
                                            : L["Last 90 days: {0} entries, not enough to judge yet", stats.Runs])</span>
                                    }
                                </span>
                                @if (current)
                                {
                                    <span style="color: var(--accent); flex: none">@Ui.Icon("check")</span>
                                }
                            </button>
                        </form>
                    }
                </div>
            </section>
        }
        <p class="empty" data-filter-empty hidden>@L["No model matches."]</p>
    </div>
    <p class="section-footer">@(Model.Task switch
        {
            AiTask.Parser => "The 40 models used most on OpenRouter last week that can return structured answers, none older than a year. Prices are OpenRouter's, per million tokens; parsing one entry uses about a thousand.",
            AiTask.Weekly => "The 40 most used recent models that can return structured answers are listed. Unset, the weekly summary uses the food parser's model. Each account uses one call of about two thousand tokens a week. Off removes the summary for every account.",
            AiTask.Onboarding => "The 40 most used recent models that can return structured answers are listed. Unset, the setup chat uses the food parser's model. One setup is about ten turns of a few thousand tokens each. Off leaves the plain form.",
            AiTask.Label => "The 40 most used recent models that accept images and return structured answers are listed. Unset, labels are read by Gemini 3.5 Flash Lite, never the food parser's model. One label photo is about two thousand tokens; a read with three photos about six thousand. Off hides label photos for every account.",
            _ => "Every decision model OpenRouter serves now, newest first; aliases and models being retired are left out. A decision model picks between the database foods the search finds, or says none fits; an entry uses a few thousand tokens, a fraction of a cent. The confidence thresholds were measured on Jev 1.13, so run an evaluation before switching. Off keeps the database ranking alone.",
        })</p>
}

@functions {
    private static int Percent(decimal share) => (int)Math.Round(share * 100);
}
