@model AdminEvalPage
@{
    ViewData["Title"] = "Eval";
    ViewData["BackUrl"] = "/admin";
    ViewData["BackLabel"] = "Admin";
}
<header class="page-head">
    <h1 class="large-title">Eval</h1>
    <p class="subhead">Re-runs the live parser and matcher on saved parses and compares them with what was saved. Spends OpenRouter credit.</p>
</header>
<partial name="_AdminNav" />

<partial name="_EvalStatus" model="Model.Job" />

@if (!Model.HasKey)
{
    <p class="section-footer">No OpenRouter key is set, so there is nothing to evaluate against.</p>
}
else
{
    <section class="section">
        <h2 class="section-title">New run</h2>
        <form method="post" asp-antiforgery="true" action="/admin/ai/eval" class="list">
            <div class="field-row">
                <label for="since">Parses since</label>
                <select id="since" name="since">
                    <option value="30d">30 days</option>
                    <option value="90d">90 days</option>
                    <option value="365d" selected>a year</option>
                </select>
            </div>
            <div class="field-row">
                <label for="limit">Parses (latest)</label>
                <input id="limit" name="limit" type="number" inputmode="numeric" min="1" max="@Plate.Web.Features.Admin.EvalJobs.MaxLimit" value="10" />
            </div>
            <div class="field-row">
                <label for="flagged">Corrected or rated down only</label>
                <input id="flagged" class="check-input" type="checkbox" name="flagged" value="true" />
            </div>
            <div class="field-row stacked">
                <label for="parser" class="footnote">Parser model (empty: @Model.ParserModel)</label>
                <input id="parser" name="parser" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="@Model.ParserModel" />
            </div>
            <div class="field-row">
                <label for="matcher">Matcher</label>
                <select id="matcher" name="matcher">
                    <option value="">Current (@Model.MatcherModel)</option>
                    @foreach (var m in Model.MatcherModels)
                    {
                        <option value="@m.Id">@(m.Id == Plate.Web.Integrations.AiTasks.Off ? "Off" : $"{m.Provider} {m.Name}")</option>
                    }
                </select>
            </div>
            <div class="row"><button type="submit" class="btn btn-plain" style="padding: 0" disabled="@(Model.Job is { Running: true })">Start</button></div>
        </form>
        <p class="section-footer">One run at a time, at most @Plate.Web.Features.Admin.EvalJobs.MaxLimit parses. The result stays here until the next run or a restart. For more, use feedback eval over SSH.</p>
    </section>
}
