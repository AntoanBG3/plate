@model AdminDashboard
@using Plate.Web.Integrations
@{
    ViewData["Title"] = "Admin";
    ViewData["BackUrl"] = "/settings";
    ViewData["BackLabel"] = "Settings";
    var d = Model.Digest;
}
<header class="page-head">
    <h1 class="large-title">Admin</h1>
    <p class="subhead">Server version @Plate.Web.Features.Diagnostics.AppVersion.Current</p>
</header>
<partial name="_AdminNav" />

<section class="section">
    <h2 class="section-title">Last 7 days</h2>
    <div class="list">
        <div class="stat-grid">
            <a class="stat" href="/admin/feedback?status=all&since=7d"><div class="stat-value">@d.Reports.Count</div><div class="stat-label">reports</div></a>
            <a class="stat" href="/admin/errors?since=7d"><div class="stat-value">@d.Errors.Count</div><div class="stat-label">errors</div></a>
            <a class="stat" href="/admin/parses?since=7d"><div class="stat-value">@d.Parses</div><div class="stat-label">parses</div></a>
        </div>
    </div>
    <p class="section-footer">@d.Confirmed saved, @d.Corrected corrected before saving. Ratings: @d.RatedUp up, @d.RatedDown down.</p>
</section>

@if (d.Reports.Count > 0)
{
    <section class="section">
        <h2 class="section-title">New reports</h2>
        <partial name="_ReportRows" model="d.Reports.Take(10).ToList()" />
    </section>
}

<section class="section">
    <h2 class="section-title">AI</h2>
    <div class="list">
        <a class="row row-link" href="/admin/ai">
            <span class="row-main">
                <span class="row-title">@(Model.Key.Source switch { KeySource.Settings => "Key saved in the app", KeySource.Environment => "Key from the server's .env", _ => "No key" })</span>
                @if (Model.Key.Last4 is not null)
                {
                    <span class="row-sub" style="display: block">ending @Model.Key.Last4</span>
                }
            </span>
            @Ui.Icon("chevron", "row-chevron")
        </a>
        @foreach (var m in Model.Models)
        {
            <div class="row"><span class="row-main">@m.Task</span><span class="row-value">@m.Model</span></div>
        }
    </div>
</section>

<section class="section">
    <h2 class="section-title">Unlock</h2>
    <form method="post" asp-antiforgery="true" action="/admin/lock" class="list">
        <div class="row">
            <span class="row-main">@(Model.UnlockEnds is { } ends ? $"Open until {ends.ToUniversalTime():HH:mm} UTC, or 30 minutes after the last admin page" : "Open")</span>
        </div>
        <div class="row"><button type="submit" class="btn btn-plain" style="padding: 0">Lock now</button></div>
    </form>
</section>
