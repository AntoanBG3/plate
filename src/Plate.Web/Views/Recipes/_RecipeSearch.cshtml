@model List<Plate.Web.Features.Food.FoodMatch>
@* Foods to add to a recipe: a tap puts the food on a new ingredient row at its serving, or 100 g. *@
@if (Model.Count == 0)
{
    <p class="subhead" style="margin: var(--s-3) var(--s-4)">@L["Nothing matches."]</p>
}
else
{
    <div class="list" style="margin-top: var(--s-3)">
        @foreach (var f in Model)
        {
            <button type="button" class="row row-link" style="width: 100%; text-align: left" data-recipe-add
                    hx-post="/food/recipes/ingredient" hx-vals='{"foodItemId": "@f.Id"}' hx-target="#recipe-rows" hx-swap="beforeend">
                <span class="row-main">
                    <span class="row-title" style="display: block">@f.DisplayName</span>
                    <span class="row-sub" style="display: block">@(f.Brand is null ? "" : f.Brand + " · ")@L["{0} kcal, {1} g protein per 100 g", Math.Round(f.KcalPer100g), f.ProteinPer100g.Kg(1)]</span>
                </span>
                @Ui.Icon("plus", "row-chevron")
            </button>
        }
    </div>
}
