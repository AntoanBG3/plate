@model PlatesViewModel
<div class="sheet-head"><span></span><span class="sheet-title" id="plates-title">@L["Plates"]</span><button type="button" class="sheet-close" data-sheet-close>@L["Done"]</button></div>
<div class="list">
    <div class="field-row">
        <label for="plates-weight">@L["Weight"]</label>
        <input id="plates-weight" class="num" type="text" name="weight" value="@(Model.TargetKg?.Kg())" min="0" max="500" step="any" inputmode="decimal" pattern="[0-9]*[.,]?[0-9]*" autocomplete="off"
               hx-get="/train/session-exercises/@Model.SessionExerciseId/plates" hx-vals='{"typed": true}' hx-trigger="input changed delay:300ms" hx-target="#plates-result" hx-select="#plates-result" hx-swap="outerHTML" />
        <span class="unit">@L["kg"]</span>
    </div>
</div>
<div id="plates-result" class="plates-result" aria-live="polite">
    @if (Model.Load is not { } load)
    {
        <p class="empty" data-plates-empty>@L["Enter a weight."]</p>
    }
    else if (load.BelowBar)
    {
        <p class="empty">@L["That's less than the bar ({0} kg).", Model.BarKg.Kg()]</p>
    }
    else
    {
        <p class="footnote">@L["Bar {0} kg", Model.BarKg.Kg()] · @L["Per side"]</p>
        <div class="plate-stack">
            @if (load.PerSide.Count == 0)
            {
                <span class="subhead">@L["Just the bar"]</span>
            }
            @foreach (var plate in load.PerSide)
            {
                <span class="plate num" data-plate="@plate.Kg()">@plate.Kg()</span>
            }
        </div>
        @* One line: the total when it is exact, else what can be loaded and what was asked for. *@
        <p class="headline num" data-total="@load.TotalKg.Kg()">@(load.Exact
            ? L["{0} kg in total", load.TotalKg.Kg()]
            : L["Closest you can load: {0} kg (you asked for {1})", load.TotalKg.Kg(), Model.TargetKg!.Value.Kg()])</p>
    }
</div>
