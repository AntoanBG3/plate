@model Plate.Web.Features.Food.WeekCard
@{
    var w = Model.Week;
    var t = Model.Targets;
}
<section class="section">
    <h2 class="section-title">@L["This week"]<span class="section-aside">@L.Count(w.LoggedDays, "average of 1 logged day", "average of {0} logged days")</span></h2>
    <div class="list week-card">
        @if (Model.TargetKcal is { } kcal)
        {
            <div class="row"><span class="row-main">@L["Calories"]</span><span class="num">@L["{0} of {1} kcal", w.Kcal, kcal]</span></div>
        }
        <div class="row">
            <span class="row-main">@L["Protein"]<span class="row-sub" style="display: block">@L["minimum reached {0} of {1} days", w.ProteinMinDays, w.LoggedDays]</span></span>
            <span class="num">@L["{0} of {1} g", w.ProteinG, t.ProteinAimG]</span>
        </div>
        <div class="row">
            <span class="row-main">@L["Fat"]<span class="row-sub" style="display: block">@L["at least the floor {0} of {1} days", w.FatFloorDays, w.LoggedDays]</span></span>
            <span class="num">@L["{0} g · {1}–{2}", w.FatG, t.FatMinG, t.FatMaxG]</span>
        </div>
        <div class="row"><span class="row-main">@L["Carbs"]</span><span class="num">@L["{0} g · {1}–{2}", w.CarbsG, t.CarbsMinG, t.CarbsMaxG]</span></div>
        <div class="row">
            <span class="row-main">@L["Fiber"]@if (w.FiberG is not null && w.FiberDays < w.LoggedDays)
                {
                    <span class="row-sub" style="display: block">@L["from {0} days with enough known", w.FiberDays]</span>
                }</span>
            <span class="num">@(w.FiberG is { } f ? L["{0} of {1} g", f, t.FiberMinG] : L["not enough known"])</span>
        </div>
        <div class="row">
            <span class="row-main">@L["Saturated fat"]@if (w.SaturatedFatG is not null && w.SaturatedFatDays < w.LoggedDays)
                {
                    <span class="row-sub" style="display: block">@L["from {0} days with enough known", w.SaturatedFatDays]</span>
                }</span>
            <span class="num">@(w.SaturatedFatG is { } s ? L["{0} g, up to {1}", s, t.SaturatedFatMaxG] : L["not enough known"])</span>
        </div>
    </div>
    <p class="section-footer">@L["Judged on the 7 days before today, against today's targets."]</p>
</section>
